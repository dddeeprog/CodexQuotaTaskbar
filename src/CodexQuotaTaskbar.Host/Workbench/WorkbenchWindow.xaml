<Window x:Class="CodexQuotaTaskbar.Host.Workbench.WorkbenchWindow" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="clr-namespace:CodexQuotaTaskbar.Host.UI"
 Title="点岛 · 项目工作台" Width="1100" Height="720" MinWidth="640" MinHeight="400"
 Background="{DynamicResource WorkbenchBackground}" Foreground="{DynamicResource WorkbenchText}"
 FontFamily="{x:Static ui:OverlayTypography.Interface}" FontSize="13" WindowStartupLocation="Manual">
 <Window.Resources>
  <SolidColorBrush x:Key="WorkbenchBackground" Color="#29292C"/>
  <SolidColorBrush x:Key="WorkbenchPane" Color="#222225"/>
  <SolidColorBrush x:Key="WorkbenchText" Color="#F2F2F4"/>
  <SolidColorBrush x:Key="WorkbenchMuted" Color="#B6B6BE"/>
  <SolidColorBrush x:Key="WorkbenchLine" Color="#49494E"/>
  <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="Foreground" Value="{DynamicResource WorkbenchText}"/><Setter Property="Background" Value="#414146"/><Setter Property="BorderBrush" Value="#64646B"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Background" Value="{DynamicResource WorkbenchPane}"/><Setter Property="Foreground" Value="{DynamicResource WorkbenchText}"/><Setter Property="BorderBrush" Value="{DynamicResource WorkbenchLine}"/><Setter Property="CaretBrush" Value="{DynamicResource WorkbenchText}"/></Style>
  <Style TargetType="TreeViewItem"><Setter Property="Foreground" Value="{DynamicResource WorkbenchText}"/><Setter Property="Padding" Value="2,4"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="{DynamicResource WorkbenchPane}"/><Setter Property="Foreground" Value="{DynamicResource WorkbenchText}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/><Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/><Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="7,6"/><Setter Property="Foreground" Value="{DynamicResource WorkbenchText}"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border BorderBrush="{DynamicResource WorkbenchLine}" BorderThickness="0,0,0,1" Padding="18,12">
   <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="PinButton" Content="置顶：关" AutomationProperties.Name="切换工作台置顶"/><Button x:Name="HotkeyButton" Content="快捷键"/><Button x:Name="RefreshButton" Content="刷新"/></StackPanel><StackPanel><TextBlock Text="项目工作台" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="DirectoryLabel" Text="选择一个本机文件夹开始" Foreground="{DynamicResource WorkbenchMuted}" Margin="0,5,12,0" TextTrimming="CharacterEllipsis"/></StackPanel></DockPanel>
  </Border>
  <DockPanel Grid.Row="1" Margin="18,10"><Button x:Name="ChooseDirectoryButton" Content="打开文件夹…"/><Button x:Name="ChooseRepositoryButton" Content="选择 Git 仓库…"/><TextBlock x:Name="RepositoryLabel" Text="尚未选择仓库" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource WorkbenchMuted}"/></DockPanel>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="280" MinWidth="210"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*" MinWidth="300"/></Grid.ColumnDefinitions>
   <Grid Background="{DynamicResource WorkbenchPane}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <UniformGrid Columns="3" Margin="12,10,6,10"><Button x:Name="FilesButton" Content="文件"/><Button x:Name="SearchButton" Content="搜索"/><Button x:Name="GitButton" Content="Git"/></UniformGrid>
    <Grid Grid.Row="1" x:Name="SidebarHost" Margin="8,0,8,8"><TextBlock x:Name="SidebarEmpty" Text="打开文件夹后，文件会显示在这里。" TextWrapping="Wrap" Margin="12,16" Foreground="{DynamicResource WorkbenchMuted}"/></Grid>
   </Grid>
   <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource WorkbenchLine}"/>
   <Grid Grid.Column="2" x:Name="PreviewHost" Margin="18,10,18,12"><StackPanel x:Name="PreviewEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360"><TextBlock Text="让项目留在手边" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="浏览文件、比较改动，再提交你确认的内容。" Foreground="{DynamicResource WorkbenchMuted}" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel></Grid>
  </Grid>
  <Border Grid.Row="3" BorderBrush="{DynamicResource WorkbenchLine}" BorderThickness="0,1,0,0" Padding="18,8"><TextBlock x:Name="StatusLabel" Text="Ctrl+Alt+G 打开或收起 · 图钉开启后保持显示" Foreground="{DynamicResource WorkbenchMuted}" TextWrapping="Wrap"/></Border>
 </Grid>
</Window>
