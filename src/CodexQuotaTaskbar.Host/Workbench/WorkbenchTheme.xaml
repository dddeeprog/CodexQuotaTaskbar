<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="clr-namespace:CodexQuotaTaskbar.Host.UI"
 xmlns:local="clr-namespace:CodexQuotaTaskbar.Host.Workbench" xmlns:sys="clr-namespace:System;assembly=mscorlib">
 <!-- The existing menu/detail grammar, scoped to workbench controls and owned dialogs. -->
 <SolidColorBrush x:Key="WorkbenchText" Color="#F4F4F6"/>
 <SolidColorBrush x:Key="WorkbenchMuted" Color="#B5B5BA"/>
 <SolidColorBrush x:Key="WorkbenchLine" Color="#28FFFFFF"/>
 <SolidColorBrush x:Key="WorkbenchPane" Color="#10000000"/>
 <SolidColorBrush x:Key="WorkbenchInput" Color="#18000000"/>
 <SolidColorBrush x:Key="WorkbenchButton" Color="#18FFFFFF"/>
 <SolidColorBrush x:Key="WorkbenchHover" Color="#0EFFFFFF"/>
 <SolidColorBrush x:Key="WorkbenchActive" Color="#22FFFFFF"/>
 <SolidColorBrush x:Key="WorkbenchSelectedText" Color="#F4F4F6"/>
 <SolidColorBrush x:Key="WorkbenchFocus" Color="#B0FFFFFF"/>
 <SolidColorBrush x:Key="WorkbenchThumb" Color="#68FFFFFF"/>
 <Thickness x:Key="WorkbenchRowPadding">8,7</Thickness>
 <sys:Double x:Key="WorkbenchTreeRowHeight">32</sys:Double>
 <Style x:Key="WorkbenchIcon" TargetType="Path">
  <Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/><Setter Property="Stretch" Value="Uniform"/><Setter Property="StrokeThickness" Value="1.35"/>
  <Setter Property="Stroke" Value="{DynamicResource WorkbenchMuted}"/><Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/><Setter Property="StrokeLineJoin" Value="Round"/>
 </Style>
 <Style x:Key="WorkbenchNavigationIcon" TargetType="Path" BasedOn="{StaticResource WorkbenchIcon}">
  <Setter Property="Stretch" Value="None"/><Setter Property="StrokeThickness" Value="1.2"/>
  <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
 </Style>
 <!-- Hidden labels retain the existing measured slots; visible icons inherit each control's state. -->
 <DataTemplate x:Key="WorkbenchPinNavigation"><Grid><TextBlock Text="{Binding}" Visibility="Hidden"/><Path Style="{StaticResource WorkbenchNavigationIcon}" Data="M5,2 L11,2 M6,2 L6,6 3.5,9 3.5,10 12.5,10 12.5,9 10,6 10,2 M8,10 L8,14.5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></DataTemplate>
 <DataTemplate x:Key="WorkbenchHotkeyNavigation"><Grid><TextBlock Text="{Binding}" Visibility="Hidden"/><Path Style="{StaticResource WorkbenchNavigationIcon}" Data="M1.5,4 L14.5,4 14.5,12 1.5,12 Z M4,6.5 L4.2,6.5 M7,6.5 L7.2,6.5 M10,6.5 L10.2,6.5 M4,9.5 L11.5,9.5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></DataTemplate>
 <DataTemplate x:Key="WorkbenchRefreshNavigation"><Grid><TextBlock Text="{Binding}" Visibility="Hidden"/><Path Style="{StaticResource WorkbenchNavigationIcon}" Data="M13.5,6.5 A5.5,5.5 0 1 0 13,11 M13.5,2.5 L13.5,6.5 9.5,6.5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></DataTemplate>
 <DataTemplate x:Key="WorkbenchFilesNavigation"><Path Style="{StaticResource WorkbenchNavigationIcon}" Data="M1.5,4 L6,4 7.5,6 14.5,6 14.5,13 1.5,13 Z"/></DataTemplate>
 <DataTemplate x:Key="WorkbenchSearchNavigation"><Path Style="{StaticResource WorkbenchNavigationIcon}" Data="M11.5,6.8 A4.7,4.7 0 1 1 2.1,6.8 A4.7,4.7 0 1 1 11.5,6.8 M10.3,10.3 L14,14"/></DataTemplate>
 <DataTemplate x:Key="WorkbenchGitNavigation"><Path Style="{StaticResource WorkbenchNavigationIcon}" Data="M4,5 L4,11 M5.8,12 C11,12 12,9 12,5 M4,1.5 A1.8,1.8 0 1 1 4,5.1 A1.8,1.8 0 1 1 4,1.5 M4,10.9 A1.8,1.8 0 1 1 4,14.5 A1.8,1.8 0 1 1 4,10.9 M12,1.5 A1.8,1.8 0 1 1 12,5.1 A1.8,1.8 0 1 1 12,1.5"/></DataTemplate>
 <Geometry x:Key="WorkbenchFileIcon">M5,2 L12,2 17,7 17,19 5,19 Z M12,2 L12,7 17,7</Geometry>
 <Geometry x:Key="WorkbenchFolderIcon">M2,5 L8,5 10,7 20,7 20,17 2,17 Z</Geometry>
 <DataTemplate x:Key="WorkbenchFolderAction"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource WorkbenchIcon}" Data="{StaticResource WorkbenchFolderIcon}" Margin="0,0,7,0"/><TextBlock Text="{Binding}" VerticalAlignment="Center"/></StackPanel></DataTemplate>
 <DataTemplate x:Key="WorkbenchRepositoryAction"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource WorkbenchIcon}" Data="M6,3 L6,16 M6,7 C6,12 16,7 16,12 M6,3 A2,2 0 1 0 6,7 A2,2 0 1 0 6,3 M16,12 A2,2 0 1 0 16,16 A2,2 0 1 0 16,12" Margin="0,0,7,0"/><TextBlock Text="{Binding}" VerticalAlignment="Center"/></StackPanel></DataTemplate>
 <Style TargetType="Button">
  <Setter Property="MinHeight" Value="32"/><Setter Property="MinWidth" Value="30"/><Setter Property="Padding" Value="12,0"/><Setter Property="Margin" Value="0,0,6,0"/>
  <Setter Property="FontFamily" Value="{x:Static ui:OverlayTypography.Interface}"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Foreground" Value="{DynamicResource WorkbenchText}"/><Setter Property="Background" Value="{DynamicResource WorkbenchButton}"/>
  <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0.5"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Grid><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"/>
    <Border x:Name="Hover" CornerRadius="9" Background="{DynamicResource WorkbenchHover}" Opacity="0" IsHitTestVisible="False"/>
    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
   </Grid><ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.68"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource WorkbenchFocus}"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="WorkbenchQuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/></Style>
 <Style x:Key="WorkbenchHeaderButton" TargetType="Button" BasedOn="{StaticResource WorkbenchQuietButton}"><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="6,0"/><Setter Property="Margin" Value="0,0,2,0"/></Style>
 <Style x:Key="WorkbenchNavigationButton" TargetType="Button" BasedOn="{StaticResource WorkbenchHeaderButton}">
  <Setter Property="Foreground" Value="{DynamicResource WorkbenchMuted}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Grid Background="Transparent">
    <Border x:Name="Circle" Width="28" Height="28" CornerRadius="14" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Grid><ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Circle" Property="Background" Value="{DynamicResource WorkbenchHover}"/><Setter Property="Foreground" Value="{DynamicResource WorkbenchText}"/></Trigger>
    <Trigger Property="Tag"><Trigger.Value><sys:Boolean>True</sys:Boolean></Trigger.Value><Setter TargetName="Circle" Property="Background" Value="{DynamicResource WorkbenchActive}"/><Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource WorkbenchSelectedText}"/><Setter Property="Foreground" Value="{DynamicResource WorkbenchSelectedText}"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Circle" Property="Background" Value="{DynamicResource WorkbenchActive}"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource WorkbenchFocus}"/><Setter TargetName="Circle" Property="BorderThickness" Value="2"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="WorkbenchLocationButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="8,0"/><Setter Property="Margin" Value="0"/></Style>
 <Style x:Key="WorkbenchMode" TargetType="RadioButton">
  <Setter Property="FontFamily" Value="{x:Static ui:OverlayTypography.Interface}"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="8,0"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{DynamicResource WorkbenchMuted}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
   <Grid Background="Transparent"><Border x:Name="Chrome" Width="28" Height="28" CornerRadius="14" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"/><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource WorkbenchHover}"/></Trigger>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource WorkbenchActive}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource WorkbenchSelectedText}"/><Setter Property="Foreground" Value="{DynamicResource WorkbenchSelectedText}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource WorkbenchFocus}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="WorkbenchScrollThumb" TargetType="Thumb"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource WorkbenchThumb}" CornerRadius="3" Margin="3"/></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="WorkbenchScrollPage" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="ScrollBar">
  <Setter Property="Width" Value="12"/><Setter Property="MinWidth" Value="0"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
   <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
    <Track.DecreaseRepeatButton><RepeatButton x:Name="Before" Style="{StaticResource WorkbenchScrollPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
    <Track.Thumb><Thumb x:Name="Thumb" Style="{StaticResource WorkbenchScrollThumb}" MinHeight="18"/></Track.Thumb>
    <Track.IncreaseRepeatButton><RepeatButton x:Name="After" Style="{StaticResource WorkbenchScrollPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
   </Track><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="Thumb" Property="MinHeight" Value="0"/><Setter TargetName="Thumb" Property="MinWidth" Value="18"/><Setter TargetName="Before" Property="Command" Value="ScrollBar.PageLeftCommand"/><Setter TargetName="After" Property="Command" Value="ScrollBar.PageRightCommand"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
  <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="12"/></Trigger></Style.Triggers>
 </Style>
 <Style x:Key="WorkbenchScroller" TargetType="ScrollViewer">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollViewer">
   <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="{TemplateBinding CanContentScroll}"/>
    <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
    <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Orientation="Horizontal" Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}" Value="{Binding HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ScrollViewer" BasedOn="{StaticResource WorkbenchScroller}"/>
 <Style TargetType="TextBox">
  <Setter Property="FontFamily" Value="{x:Static ui:OverlayTypography.Interface}"/>
  <Setter Property="Padding" Value="10,7"/><Setter Property="Background" Value="{DynamicResource WorkbenchInput}"/><Setter Property="Foreground" Value="{DynamicResource WorkbenchText}"/><Setter Property="CaretBrush" Value="{DynamicResource WorkbenchText}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource WorkbenchLine}"/><Setter Property="BorderThickness" Value="0.5"/><Setter Property="SelectionBrush" Value="{DynamicResource WorkbenchActive}"/><Setter Property="FontSize" Value="13"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Chrome" CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost" Style="{StaticResource WorkbenchScroller}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource WorkbenchFocus}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ListBox">
  <Setter Property="FontFamily" Value="{x:Static ui:OverlayTypography.Interface}"/>
  <Setter Property="FontSize" Value="13"/>
  <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource WorkbenchText}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
  <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/><Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><Border Background="{TemplateBinding Background}"><ScrollViewer Style="{StaticResource WorkbenchScroller}" Focusable="False" CanContentScroll="True"><ItemsPresenter/></ScrollViewer></Border></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ListBoxItem">
  <Setter Property="FontFamily" Value="{x:Static ui:OverlayTypography.Interface}"/>
  <Setter Property="FontSize" Value="13"/>
  <Setter Property="Padding" Value="{DynamicResource WorkbenchRowPadding}"/><Setter Property="Margin" Value="0,1"/><Setter Property="Foreground" Value="{DynamicResource WorkbenchText}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Chrome" CornerRadius="6" BorderThickness="0.5" BorderBrush="Transparent" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/></Border><ControlTemplate.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource WorkbenchHover}"/></Trigger>
   <Trigger Property="IsSelected" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource WorkbenchActive}"/><Setter Property="Foreground" Value="{DynamicResource WorkbenchSelectedText}"/></Trigger>
   <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource WorkbenchFocus}"/></Trigger>
  </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="WorkbenchExpander" TargetType="ToggleButton">
  <Setter Property="Focusable" Value="False"/><Setter Property="Width" Value="18"/><Setter Property="Height" Value="{DynamicResource WorkbenchTreeRowHeight}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><Path x:Name="Arrow" Data="M1,1 L4,4 1,7" Stroke="{DynamicResource WorkbenchMuted}" StrokeThickness="1.2" Width="4" Height="7" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="WorkbenchDiffItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
  <Setter Property="Padding" Value="0,2"/><Setter Property="Margin" Value="0"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Chrome" Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="0.5" Background="Transparent"><ContentPresenter HorizontalAlignment="Stretch"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource WorkbenchFocus}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <DataTemplate x:Key="WorkbenchTreeHeader">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions><Path x:Name="Icon" Style="{StaticResource WorkbenchIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Data="{StaticResource WorkbenchFileIcon}" HorizontalAlignment="Left"/><TextBlock Grid.Column="1" Text="{Binding}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></Grid>
  <DataTemplate.Triggers><DataTrigger Binding="{Binding Tag.IsDirectory, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True"><Setter TargetName="Icon" Property="Data" Value="{StaticResource WorkbenchFolderIcon}"/></DataTrigger></DataTemplate.Triggers>
 </DataTemplate>
 <Style TargetType="TreeViewItem">
  <Setter Property="FontFamily" Value="{x:Static ui:OverlayTypography.Interface}"/>
  <Setter Property="FontSize" Value="13"/>
  <Setter Property="Foreground" Value="{DynamicResource WorkbenchText}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="HeaderTemplate" Value="{StaticResource WorkbenchTreeHeader}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TreeViewItem">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <Border x:Name="Chrome" Grid.ColumnSpan="2" Background="Transparent" CornerRadius="6" BorderBrush="Transparent" BorderThickness="0.5" MinHeight="{DynamicResource WorkbenchTreeRowHeight}"/>
    <ToggleButton x:Name="Expander" Style="{StaticResource WorkbenchExpander}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"/>
    <ContentPresenter Grid.Column="1" ContentSource="Header" Margin="2,4,6,4" VerticalAlignment="Center"/>
    <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1"/>
   </Grid><ControlTemplate.Triggers>
    <Trigger Property="IsExpanded" Value="False"><Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/></Trigger>
    <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden"/></Trigger>
    <Trigger Property="IsMouseDirectlyOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource WorkbenchHover}"/></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource WorkbenchActive}"/><Setter Property="Foreground" Value="{DynamicResource WorkbenchSelectedText}"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource WorkbenchFocus}"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="TreeView"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TreeView"><ScrollViewer Style="{StaticResource WorkbenchScroller}" Focusable="False" CanContentScroll="True"><ItemsPresenter/></ScrollViewer></ControlTemplate></Setter.Value></Setter></Style>
 <DataTemplate x:Key="WorkbenchGitChange">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="23"/><ColumnDefinition/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
   <Path Style="{StaticResource WorkbenchIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Data="{StaticResource WorkbenchFileIcon}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0"/>
   <StackPanel Grid.Column="1"><TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/><TextBlock x:Name="Area" Text="未暂存" FontSize="11" Margin="0,2,0,0"/></StackPanel>
   <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="11" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="4,2,0,0"/>
  </Grid><DataTemplate.Triggers>
   <DataTrigger Binding="{Binding Area}" Value="{x:Static local:GitArea.Staged}"><Setter TargetName="Area" Property="Text" Value="已暂存"/></DataTrigger>
   <DataTrigger Binding="{Binding Area}" Value="{x:Static local:GitArea.Untracked}"><Setter TargetName="Area" Property="Text" Value="新文件"/></DataTrigger>
   <DataTrigger Binding="{Binding Area}" Value="{x:Static local:GitArea.Conflict}"><Setter TargetName="Area" Property="Text" Value="冲突"/></DataTrigger>
  </DataTemplate.Triggers>
 </DataTemplate>
 <DataTemplate x:Key="WorkbenchDiffRow">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/><ColumnDefinition Width="36"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding OldLine}" Foreground="{DynamicResource WorkbenchMuted}" FontSize="11"/><TextBlock x:Name="OldSign" FontSize="11" Margin="4,0,0,0"/></StackPanel>
   <Border x:Name="OldCell" Grid.Column="1" Tag="{Binding Kind}" Padding="6,3"><TextBlock Text="{Binding OldText}" FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap" ToolTip="{Binding OldText}"/></Border>
   <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0"><TextBlock Text="{Binding NewLine}" Foreground="{DynamicResource WorkbenchMuted}" FontSize="11"/><TextBlock x:Name="NewSign" FontSize="11" Margin="4,0,0,0"/></StackPanel>
   <Border x:Name="NewCell" Grid.Column="3" Tag="{Binding Kind}" Padding="6,3"><TextBlock Text="{Binding NewText}" FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap" ToolTip="{Binding NewText}"/></Border>
  </Grid>
  <DataTemplate.Triggers>
   <DataTrigger Binding="{Binding Kind}" Value="delete"><Setter TargetName="OldCell" Property="Background" Value="{DynamicResource WorkbenchDiffRemoved}"/><Setter TargetName="OldSign" Property="Text" Value="−"/></DataTrigger>
   <DataTrigger Binding="{Binding Kind}" Value="add"><Setter TargetName="NewCell" Property="Background" Value="{DynamicResource WorkbenchDiffAdded}"/><Setter TargetName="NewSign" Property="Text" Value="+"/></DataTrigger>
   <DataTrigger Binding="{Binding Kind}" Value="replace"><Setter TargetName="OldCell" Property="Background" Value="{DynamicResource WorkbenchDiffRemoved}"/><Setter TargetName="OldSign" Property="Text" Value="−"/><Setter TargetName="NewCell" Property="Background" Value="{DynamicResource WorkbenchDiffAdded}"/><Setter TargetName="NewSign" Property="Text" Value="+"/></DataTrigger>
  </DataTemplate.Triggers>
 </DataTemplate>
 <DataTemplate x:Key="WorkbenchGitCompactChange">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
   <Path Style="{StaticResource WorkbenchIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Data="{StaticResource WorkbenchFileIcon}" HorizontalAlignment="Left"/>
   <TextBlock Grid.Column="1" Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" VerticalAlignment="Center"/>
   <TextBlock x:Name="Area" Grid.Column="2" Text="未暂存" FontSize="11" Margin="8,0,4,0" VerticalAlignment="Center"/>
   <TextBlock Grid.Column="3" Text="{Binding Status}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
  </Grid><DataTemplate.Triggers>
   <DataTrigger Binding="{Binding Area}" Value="{x:Static local:GitArea.Staged}"><Setter TargetName="Area" Property="Text" Value="已暂存"/></DataTrigger>
   <DataTrigger Binding="{Binding Area}" Value="{x:Static local:GitArea.Untracked}"><Setter TargetName="Area" Property="Text" Value="新文件"/></DataTrigger>
   <DataTrigger Binding="{Binding Area}" Value="{x:Static local:GitArea.Conflict}"><Setter TargetName="Area" Property="Text" Value="冲突"/></DataTrigger>
  </DataTemplate.Triggers>
 </DataTemplate>
 <Style TargetType="ContextMenu"><Setter Property="MinWidth" Value="150"/><Setter Property="Background" Value="{DynamicResource WorkbenchBackground}"/><Setter Property="Foreground" Value="{DynamicResource WorkbenchText}"/><Setter Property="FontFamily" Value="{x:Static ui:OverlayTypography.Interface}"/><Setter Property="FontSize" Value="13"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource WorkbenchLine}" BorderThickness="0.5" CornerRadius="12" Padding="6"><ItemsPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="Separator"><Setter Property="Margin" Value="4,4"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="0.5" Background="{DynamicResource WorkbenchLine}"/></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="MenuItem"><Setter Property="FontFamily" Value="{x:Static ui:OverlayTypography.Interface}"/><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="10,0"/><Setter Property="MinHeight" Value="32"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="Chrome" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource WorkbenchHover}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
