<Window x:Class="CodexQuotaTaskbar.Host.UI.UpdateStatusWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CodexQuotaTaskbar.Host.UI"
        Title="点岛 · 软件更新" Width="360" SizeToContent="Height" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" WindowStartupLocation="CenterScreen"
        FontFamily="{x:Static ui:OverlayTypography.Interface}" FontSize="13" FontWeight="SemiBold"
        UseLayoutRounding="True" TextOptions.TextRenderingMode="Grayscale">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="14,0"/>
      <Setter Property="Background" Value="#18FFFFFF"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="10">
    <Border x:Name="BackdropLayer" CornerRadius="16" Background="Transparent" IsHitTestVisible="False"/>
    <Border x:Name="Surface" CornerRadius="16" Background="{x:Static ui:OverlayGlassMaterial.Surface}" Padding="18">
      <StackPanel>
        <TextBlock x:Name="StatusTitle" FontSize="17" Foreground="White" Margin="0,0,0,8" TextWrapping="Wrap"/>
        <TextBlock x:Name="MessageText" Foreground="#DEDEE2" TextWrapping="Wrap" LineHeight="21"/>
        <TextBlock x:Name="DetailText" Foreground="#C2C2C6" FontSize="11" TextWrapping="Wrap" LineHeight="18" Margin="0,10,0,0"/>
        <ProgressBar x:Name="Progress" Height="4" Margin="0,16,0,0" Foreground="#E9E9EE" Background="#25FFFFFF" BorderThickness="0" Maximum="100"/>
        <TextBlock x:Name="ProgressText" Margin="0,6,0,0" FontSize="11" Foreground="#C2C2C6"/>
        <Border Height="1" Margin="0,18,0,14" Background="#60FFFFFF"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Button x:Name="DismissButton" Content="关闭" HorizontalAlignment="Left"/>
          <Button x:Name="RetryButton" Grid.Column="1" Content="重试" Background="#F2F2F4" Foreground="#111113" Margin="10,0,0,0"/>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</Window>
