<Window x:Class="CodexQuotaTaskbar.Host.UI.QuotaPopoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CodexQuotaTaskbar.Host.UI"
        Title="Codex 额度详情" Width="328" SizeToContent="Height" MaxHeight="520"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True">
  <Window.Resources>
    <Style x:Key="LiquidProgress" TargetType="ProgressBar">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
        <Grid Height="5"><Border Background="#20FFFFFF" CornerRadius="2.5"/><Grid x:Name="PART_Track"><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="2.5"/></Grid></Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CircleButton" TargetType="Button">
      <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/>
      <Setter Property="Foreground" Value="#C8FFFFFF"/><Setter Property="Background" Value="#18FFFFFF"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="16"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}" CornerRadius="15">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,1"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonChrome" Property="Background" Value="#2AFFFFFF"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonChrome" Property="Opacity" Value="0.72"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="GlassButton" TargetType="Button">
      <Setter Property="Height" Value="40"/><Setter Property="Padding" Value="15,0"/>
      <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#18FFFFFF"/>
      <Setter Property="BorderBrush" Value="#24FFFFFF"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontFamily" Value="{x:Static ui:OverlayTypography.Text}"/><Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonChrome" Property="Background" Value="#2DFFFFFF"/><Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#42FFFFFF"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonChrome" Property="Opacity" Value="0.72"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid x:Name="PopoverShell" RenderTransformOrigin="0.5,0.5">
    <Grid.RenderTransform>
      <TransformGroup>
        <ScaleTransform x:Name="PopoverScale" ScaleX="1" ScaleY="1"/>
        <TranslateTransform x:Name="PopoverTranslate"/>
      </TransformGroup>
    </Grid.RenderTransform>
    <Border x:Name="BackdropLayer" CornerRadius="28" Background="#011D1D1F"/>
    <Border x:Name="GlassBorder" CornerRadius="28"
            Background="{x:Static ui:OverlayGlassMaterial.Surface}"
            BorderBrush="{x:Static ui:OverlayGlassMaterial.Border}" BorderThickness="1">
    <Grid Margin="20,18,20,18">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="TitleText" Text="Codex 额度" Foreground="#FAFFFFFF" FontFamily="{x:Static ui:OverlayTypography.Display}" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="USAGE" Foreground="#78FFFFFF" FontFamily="{x:Static ui:OverlayTypography.Text}" FontSize="9" FontWeight="SemiBold" Margin="1,2,0,0" />
        </StackPanel>
        <Button x:Name="CloseButton" Grid.Column="1" Content="×" Style="{StaticResource CircleButton}" AutomationProperties.Name="关闭" />
      </Grid>
      <TextBlock x:Name="StatusText" Grid.Row="1" Margin="1,10,0,14" Foreground="#9EAFAFB3" FontFamily="{x:Static ui:OverlayTypography.Text}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
      <ScrollViewer Grid.Row="2" MaxHeight="340" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Border x:Name="AccountSummaryBorder" Margin="0,0,0,14" Background="#16FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="16">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="7,10" AutomationProperties.Name="订阅计划">
                <TextBlock Text="订阅" Tag="secondary" Foreground="#9EAFAFB3" FontFamily="{x:Static ui:OverlayTypography.Text}" FontSize="9" TextAlignment="Center" />
                <TextBlock x:Name="PlanText" Text="未知" Foreground="#F2FFFFFF" FontFamily="{x:Static ui:OverlayTypography.Text}" FontSize="11.5" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,3,0,0" />
              </StackPanel>
              <Border x:Name="AccountDividerOne" Grid.Column="1" Margin="0,9" Background="#22FFFFFF" />
              <StackPanel Grid.Column="2" Margin="5,10" AutomationProperties.Name="会员到期时间">
                <TextBlock Text="订阅有效至" Tag="secondary" Foreground="#9EAFAFB3" FontFamily="{x:Static ui:OverlayTypography.Text}" FontSize="9" TextAlignment="Center" />
                <TextBlock x:Name="ExpiryText" Text="正在读取…" Tag="secondary" Foreground="#F2FFFFFF" FontFamily="{x:Static ui:OverlayTypography.Text}" FontSize="10.5" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
              </StackPanel>
              <Border x:Name="AccountDividerTwo" Grid.Column="3" Margin="0,9" Background="#22FFFFFF" />
              <StackPanel Grid.Column="4" Margin="7,10" AutomationProperties.Name="额外点数数量">
                <TextBlock Text="额外点数" Tag="secondary" Foreground="#9EAFAFB3" FontFamily="{x:Static ui:OverlayTypography.Text}" FontSize="9" TextAlignment="Center" />
                <TextBlock x:Name="ExtraCreditsText" Text="—" Tag="secondary" Foreground="#F2FFFFFF" FontFamily="{x:Static ui:OverlayTypography.Number}" FontSize="11.5" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
              </StackPanel>
              <TextBlock x:Name="ExpiryMetaText" Grid.Row="1" Grid.ColumnSpan="5" Tag="secondary" Margin="9,-3,9,9"
                         Text="来源：正在确认" Foreground="#9EAFAFB3" FontFamily="{x:Static ui:OverlayTypography.Text}" FontSize="8.5"
                         TextAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>
          </Border>
          <Button x:Name="SubscriptionLoginButton" Content="网页登录 · 更新订阅日期" Style="{StaticResource GlassButton}" Height="30" FontSize="10.5" Margin="0,-4,0,12"/>
          <TextBlock x:Name="QuotaHeading" Text="额度" Tag="secondary" Foreground="#9EAFAFB3" FontFamily="{x:Static ui:OverlayTypography.Text}" FontSize="10" FontWeight="SemiBold" Margin="1,0,0,7" />
          <StackPanel x:Name="RowsPanel" />
          <StackPanel x:Name="ResetSection" Margin="1,10,1,0">
            <TextBlock x:Name="ResetFeedStatusText" Visibility="Collapsed" Tag="secondary" FontFamily="{x:Static ui:OverlayTypography.Text}" FontSize="9.5" TextWrapping="Wrap" Foreground="#AEAEB2" Margin="0,0,0,10" />
            <StackPanel x:Name="ResetAnnouncementsPanel" />
            <Button x:Name="ResetSiteButton" Content="来源：Codex Resets ↗" Style="{StaticResource GlassButton}" Height="30" FontSize="10.5" Margin="0,2,0,0" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <Grid Grid.Row="3" Margin="0,16,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Button x:Name="RefreshButton" Content="刷新" Style="{StaticResource GlassButton}" />
        <Button x:Name="OpenCodexButton" Grid.Column="2" Content="打开 Codex" Style="{StaticResource GlassButton}" Background="#EAF7F7F8" BorderBrush="#F8FFFFFF" Foreground="#111113" />
      </Grid>
    </Grid>
    </Border>
  </Grid>
</Window>
