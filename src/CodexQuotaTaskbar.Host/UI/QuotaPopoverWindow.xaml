<Window x:Class="CodexQuotaTaskbar.Host.UI.QuotaPopoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CodexQuotaTaskbar.Host.UI"
        Title="点岛 · 额度详情" Width="360" SizeToContent="Height" MaxHeight="552"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="{x:Static ui:OverlayTypography.Interface}" FontWeight="SemiBold" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale" Typography.NumeralAlignment="Tabular">
  <Window.Resources>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#F0F0F2"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="LiquidProgress" TargetType="ProgressBar">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
        <Grid Height="5"><Border Background="#20FFFFFF" CornerRadius="2.5"/><Grid x:Name="PART_Track"><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="2.5"/></Grid></Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CircleButton" TargetType="Button">
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Width" Value="26"/><Setter Property="Height" Value="26"/>
      <Setter Property="Foreground" Value="#C8FFFFFF"/><Setter Property="Background" Value="#18FFFFFF"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="16"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}" CornerRadius="13">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,1"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonChrome" Property="Background" Value="#2AFFFFFF"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonChrome" Property="Opacity" Value="0.72"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="GlassButton" TargetType="Button">
      <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="15,0"/>
      <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#18FFFFFF"/>
      <Setter Property="BorderBrush" Value="#24FFFFFF"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontFamily" Value="{x:Static ui:OverlayTypography.Interface}"/><Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid>
          <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"/>
          <Border x:Name="HoverChrome" Background="#18FFFFFF" CornerRadius="9" Opacity="0" IsHitTestVisible="False"/>
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HoverChrome" Property="Opacity" Value="1"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HoverChrome" Property="Opacity" Value="1"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonChrome" Property="Opacity" Value="0.72"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ShortcutButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
      <Setter Property="Width" Value="52"/><Setter Property="Height" Value="52"/>
      <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="Background" Value="#14FFFFFF"/><Setter Property="BorderBrush" Value="#20FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid>
          <Border x:Name="ShortcutChrome" Background="{TemplateBinding Background}" CornerRadius="13"/>
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <Border x:Name="ShortcutOutline" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="13" IsHitTestVisible="False"/>
          <Border x:Name="ShortcutHover" Background="#18FFFFFF" CornerRadius="13" Opacity="0" IsHitTestVisible="False"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ShortcutHover" Property="Opacity" Value="1"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ShortcutHover" Property="Opacity" Value="1"/><Setter TargetName="ShortcutOutline" Property="BorderBrush" Value="#B0FFFFFF"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="ShortcutHover" Property="Opacity" Value="0.6"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid x:Name="PopoverShell" Margin="16" RenderTransformOrigin="0.5,0.5">
    <Grid.RenderTransform>
      <TransformGroup>
        <ScaleTransform x:Name="PopoverScale" ScaleX="1" ScaleY="1"/>
        <TranslateTransform x:Name="PopoverTranslate"/>
      </TransformGroup>
    </Grid.RenderTransform>
    <Border x:Name="SurfaceShadow" CornerRadius="16" Background="Transparent" BorderBrush="#50000000" BorderThickness="1" IsHitTestVisible="False"><Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.2"/></Border.Effect></Border>
    <Border x:Name="BackdropLayer" CornerRadius="16" Background="#011D1D1F"/>
    <Border x:Name="GlassBorder" CornerRadius="16"
            Background="{x:Static ui:OverlayGlassMaterial.Surface}"
            BorderBrush="{x:Static ui:OverlayGlassMaterial.Border}" BorderThickness="0.5">
    <Grid Margin="16">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="TitleText" Text="点岛" Foreground="#FAFFFFFF" FontFamily="{x:Static ui:OverlayTypography.Interface}" FontSize="15" FontWeight="SemiBold" />

        </StackPanel>
        <Button x:Name="CloseButton" Grid.Column="1" Content="×" Style="{StaticResource CircleButton}" AutomationProperties.Name="关闭" />
      </Grid>
      <ScrollViewer x:Name="DetailsScroller" Grid.Row="1" Margin="0,12,0,0" MaxHeight="400" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Border x:Name="AccountSectionDivider" BorderBrush="#60FFFFFF" BorderThickness="0,0,0,1" SnapsToDevicePixels="True" Padding="0,0,0,12">
          <StackPanel x:Name="AccountSection" AutomationProperties.Name="账户与订阅">
          <TextBlock x:Name="AccountSectionTitle" Text="账户与订阅" Style="{StaticResource SectionTitle}"/>
          <Border x:Name="AccountSummaryBorder" Background="Transparent" BorderThickness="0" Padding="0">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="订阅计划" Tag="secondary" FontSize="12" VerticalAlignment="Center"/>
              <TextBlock x:Name="PlanText" Grid.Column="1" Text="未知" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.Name="订阅计划"/>
              <TextBlock Grid.Row="1" Text="订阅有效至" Tag="secondary" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
              <TextBlock x:Name="ExpiryText" Grid.Row="1" Grid.Column="1" Text="正在读取…" Tag="secondary" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.Name="会员到期时间"/>
              <TextBlock Grid.Row="2" Text="额外点数" Tag="secondary" FontSize="12" VerticalAlignment="Center"/>
              <TextBlock x:Name="ExtraCreditsText" Grid.Row="2" Grid.Column="1" Text="—" Tag="secondary" FontSize="13" MinWidth="96" TextAlignment="Right" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.Name="额外点数数量"/>
              <Border x:Name="AccountDividerOne" Visibility="Collapsed"/>
              <Border x:Name="AccountDividerTwo" Visibility="Collapsed"/>
            </Grid>
          </Border>
          <Button x:Name="SubscriptionLoginButton" Content="网页登录 · 更新订阅日期" Style="{StaticResource GlassButton}" Height="28" FontSize="11" HorizontalAlignment="Left" Padding="0" Margin="0,4,0,0" Background="Transparent"/>
          </StackPanel>
          </Border>
          <Border x:Name="QuotaSectionDivider" BorderBrush="#60FFFFFF" BorderThickness="0,0,0,1" SnapsToDevicePixels="True" Margin="0,16,0,0" Padding="0,0,0,8">
          <StackPanel x:Name="QuotaSection" AutomationProperties.Name="额度">
            <TextBlock x:Name="QuotaSectionTitle" Text="额度" Style="{StaticResource SectionTitle}"/>
            <StackPanel x:Name="RowsPanel" />
          </StackPanel>
          </Border>
          <StackPanel x:Name="AnnouncementsSection" Margin="0,16,0,0" AutomationProperties.Name="常用网站">
          <TextBlock x:Name="ShortcutsSectionTitle" Text="常用网站" Style="{StaticResource SectionTitle}"/>
          <StackPanel x:Name="ShortcutsSection">
            <TextBlock x:Name="ShortcutsStatusText" Text="正在读取网站…" Tag="secondary" FontFamily="{x:Static ui:OverlayTypography.Interface}" FontSize="11" TextWrapping="Wrap" Foreground="#AEAEB2" Margin="0,0,0,8" />
            <WrapPanel x:Name="ShortcutsGrid" HorizontalAlignment="Left">
              <Button x:Name="AddShortcutButton" Content="+" Style="{StaticResource ShortcutButton}" FontSize="25" FontWeight="Light" Background="Transparent" BorderBrush="#38FFFFFF" ToolTip="添加网站" AutomationProperties.Name="添加网站"/>
            </WrapPanel>
          </StackPanel>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <Grid Grid.Row="2" Margin="0,12,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Button x:Name="RefreshButton" Content="刷新" Style="{StaticResource GlassButton}" />
        <Button x:Name="OpenCodexButton" Grid.Column="2" Content="打开 Codex" Style="{StaticResource GlassButton}" Background="#EAF7F7F8" BorderBrush="#F8FFFFFF" Foreground="#111113" />
      </Grid>
    </Grid>
    </Border>
  </Grid>
</Window>
