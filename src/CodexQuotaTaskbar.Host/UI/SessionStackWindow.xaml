<Window x:Class="CodexQuotaTaskbar.Host.UI.SessionStackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CodexQuotaTaskbar.Host.UI"
        Title="Codex 会话" Width="392" Height="98"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        SnapsToDevicePixels="True">
  <Window.Resources>
    <LinearGradientBrush x:Key="SessionGlassSurfaceHover" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#9A424244" Offset="0"/>
      <GradientStop Color="#88363638" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CollapsedMiddleGlassSurface" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#B83A3A3C" Offset="0"/>
      <GradientStop Color="#A82C2C2E" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CollapsedBackGlassSurface" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#A8343436" Offset="0"/>
      <GradientStop Color="#9828282A" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="SessionPill" TargetType="Button">
      <Setter Property="Width" Value="344"/>
      <Setter Property="Height" Value="58"/>
      <Setter Property="Padding" Value="20,8"/>
      <Setter Property="Foreground" Value="#FAFFFFFF"/>
      <Setter Property="Background" Value="{x:Static ui:OverlayGlassMaterial.Surface}"/>
      <Setter Property="BorderBrush" Value="{x:Static ui:OverlayGlassMaterial.Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Chrome"
                      CornerRadius="29"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}">
                <ContentPresenter Margin="{TemplateBinding Padding}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SessionGlassSurfaceHover}"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#58FFFFFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.76"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ExpandButton" TargetType="Button">
      <Setter Property="Width" Value="24"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Background" Value="{x:Static ui:OverlayGlassMaterial.Surface}"/>
      <Setter Property="BorderBrush" Value="#58FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" CornerRadius="12" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource SessionGlassSurfaceHover}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.7"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid x:Name="Shell">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border x:Name="GlassCaptureSurface"
            Grid.RowSpan="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="#011D1D1F"
            IsHitTestVisible="False"/>
    <Grid x:Name="CardsViewport" RenderTransformOrigin="0.5,0.5">
      <Grid.RenderTransform>
        <TranslateTransform x:Name="CardsTransitionTranslate"/>
      </Grid.RenderTransform>
      <StackPanel x:Name="ShadowSlots" Margin="24,16,24,24" IsHitTestVisible="False">
        <StackPanel.RenderTransform>
          <TranslateTransform x:Name="ShadowTranslate"/>
        </StackPanel.RenderTransform>
      </StackPanel>
      <Grid x:Name="CollapsedLayers" IsHitTestVisible="False">
        <Border x:Name="CollapsedBackLayer" Width="324" Height="58" Margin="0,28,0,0" VerticalAlignment="Top"
                CornerRadius="29" Background="{StaticResource CollapsedBackGlassSurface}" BorderBrush="#36FFFFFF" BorderThickness="1"/>
        <Border x:Name="CollapsedMiddleLayer" Width="334" Height="58" Margin="0,22,0,0" VerticalAlignment="Top"
                CornerRadius="29" Background="{StaticResource CollapsedMiddleGlassSurface}" BorderBrush="#44FFFFFF" BorderThickness="1"/>
      </Grid>
      <Grid x:Name="LayerTransitionOverlay" Panel.ZIndex="1" IsHitTestVisible="False"/>
      <ScrollViewer x:Name="SessionsScroller"
                    Panel.ZIndex="2"
                    Margin="24,16,24,24"
                    VerticalAlignment="Top"
                    VerticalScrollBarVisibility="Hidden"
                    HorizontalScrollBarVisibility="Disabled"
                    CanContentScroll="False"
                    PanningMode="VerticalOnly">
        <StackPanel x:Name="SessionsPanel"/>
      </ScrollViewer>
      <Grid x:Name="CardTransitionOverlay" Panel.ZIndex="1" IsHitTestVisible="False"/>
    </Grid>
    <Button x:Name="ExpandButton" Grid.Row="1" Margin="0,8,0,0"
            HorizontalAlignment="Center" Style="{StaticResource ExpandButton}"
            AutomationProperties.Name="展开会话">
      <Path x:Name="ExpandChevron" Width="10" Height="6" Stroke="#EEFFFFFF" StrokeThickness="1.6"
            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
            Data="M 1,1 L 5,5 L 9,1"/>
    </Button>
  </Grid>
</Window>
