<Window x:Class="CodexQuotaTaskbar.Host.UI.QuotaCapsuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CodexQuotaTaskbar.Host.UI"
        Title="Codex 额度" Width="306" Height="92"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        SnapsToDevicePixels="True">
  <!--
  THESIS: Codex quota is a glanceable frosted taskbar surface, not a dashboard card.
  OWN-WORLD: native WPF background blur, quiet cyan status, precise paired rails.
  STORY: see two remaining windows; click for reset details; right-click for control.
  FIRST VIEWPORT: 272x48 capsule with an overlapping numeric activity badge inside a 12-DIP shadow-safe window, 38-DIP squircle mark left, two quota rows right.
  FORM: native frosted glass powered by BlurredBackground.WPF.
  -->
  <Window.Resources>
    <LinearGradientBrush x:Key="WaitingLightFill" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FFFFA39E" Offset="0"/>
      <GradientStop Color="#F2FF5F57" Offset="0.56"/>
      <GradientStop Color="#D9C53F38" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RunningLightFill" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FFFFE19A" Offset="0"/>
      <GradientStop Color="#F2FEBC2E" Offset="0.56"/>
      <GradientStop Color="#D9B77A12" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CompletedLightFill" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FF98E7A6" Offset="0"/>
      <GradientStop Color="#F228C840" Offset="0.56"/>
      <GradientStop Color="#D918872B" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="LiquidProgress" TargetType="ProgressBar">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid Height="5">
              <Border Background="#24FFFFFF" CornerRadius="2" />
              <Grid x:Name="PART_Track">
                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="2" />
              </Grid>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid x:Name="Shell">
    <Border x:Name="BackdropLayer" Margin="12,28,22,16" CornerRadius="24" Background="#011D1D1F"/>
    <Border x:Name="GlassBorder" Margin="12,28,22,16" CornerRadius="24"
            Background="{x:Static ui:OverlayGlassMaterial.Surface}"
            BorderBrush="{x:Static ui:OverlayGlassMaterial.Border}" BorderThickness="1">
    <Grid Margin="8,5,14,5">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="38" />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Width="38" Height="38" CornerRadius="14" Background="#1AFFFFFF" BorderBrush="#34FFFFFF" BorderThickness="1" VerticalAlignment="Center">
        <Rectangle Width="21" Height="21" Fill="#F5FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
          <Rectangle.OpacityMask>
            <ImageBrush ImageSource="/CodexQuotaTaskbar;component/Assets/OpenAILogo.png"
                        ViewboxUnits="Absolute"
                        Viewbox="1124,274,1591,1613"
                        Stretch="Uniform" />
          </Rectangle.OpacityMask>
        </Rectangle>
      </Border>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="19" />
          <RowDefinition Height="19" />
        </Grid.RowDefinitions>
        <Grid x:Name="FirstRow" Grid.Row="0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="FirstLabel" Foreground="#D8D8DC" FontFamily="{x:Static ui:OverlayTypography.Text}" FontSize="10" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <ProgressBar x:Name="FirstBar" Grid.Column="1" Style="{StaticResource LiquidProgress}" VerticalAlignment="Center" Minimum="0" Maximum="100" Foreground="#F2F2F7" />
          <TextBlock x:Name="FirstValue" Grid.Column="2" Foreground="#FAFFFFFF" FontFamily="{x:Static ui:OverlayTypography.Number}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
        <Grid x:Name="SecondRow" Grid.Row="1">
          <Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="SecondLabel" Foreground="#D8D8DC" FontFamily="{x:Static ui:OverlayTypography.Text}" FontSize="10" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <ProgressBar x:Name="SecondBar" Grid.Column="1" Style="{StaticResource LiquidProgress}" VerticalAlignment="Center" Minimum="0" Maximum="100" Foreground="#F2F2F7" />
          <TextBlock x:Name="SecondValue" Grid.Column="2" Foreground="#FAFFFFFF" FontFamily="{x:Static ui:OverlayTypography.Number}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
      </Grid>
    </Grid>
    </Border>
    <Border x:Name="SessionBadge" MinWidth="22" Height="22" CornerRadius="11" Padding="3,1"
            HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="3"
            Margin="0,12,12,0" BorderBrush="#38FFFFFF" BorderThickness="1" Visibility="Collapsed"
            RenderTransformOrigin="0.5,0.5">
      <Border.RenderTransform><ScaleTransform x:Name="SessionBadgeScale"/></Border.RenderTransform>
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#A838383C" Offset="0"/>
          <GradientStop Color="#A0171719" Offset="0.56"/>
          <GradientStop Color="#A829292D" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <Border.Effect>
        <DropShadowEffect Color="#000000" BlurRadius="9" ShadowDepth="2" Opacity="0.34"/>
      </Border.Effect>
      <StackPanel Orientation="Horizontal">
        <Grid x:Name="WaitingLight" Width="16" Height="16" Margin="0,0,3,0" Visibility="Collapsed" ToolTip="待授权" RenderTransformOrigin="0.5,0.5">
          <Grid.RenderTransform><ScaleTransform x:Name="WaitingLightScale"/></Grid.RenderTransform>
          <Ellipse Fill="{StaticResource WaitingLightFill}" Stroke="#48FFFFFF" StrokeThickness="0.5"/>
          <TextBlock x:Name="WaitingLightText" Foreground="White" FontFamily="{x:Static ui:OverlayTypography.Number}" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <TextBlock.RenderTransform>
              <TransformGroup>
                <ScaleTransform x:Name="WaitingTextScale"/>
                <TranslateTransform x:Name="WaitingTextTranslate"/>
              </TransformGroup>
            </TextBlock.RenderTransform>
          </TextBlock>
        </Grid>
        <Grid x:Name="RunningLight" Width="16" Height="16" Margin="0,0,3,0" Visibility="Collapsed" ToolTip="进行中" RenderTransformOrigin="0.5,0.5">
          <Grid.RenderTransform><ScaleTransform x:Name="RunningLightScale"/></Grid.RenderTransform>
          <Ellipse Fill="{StaticResource RunningLightFill}" Stroke="#48FFFFFF" StrokeThickness="0.5"/>
          <TextBlock x:Name="RunningLightText" Foreground="#6B4300" FontFamily="{x:Static ui:OverlayTypography.Number}" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <TextBlock.RenderTransform>
              <TransformGroup>
                <ScaleTransform x:Name="RunningTextScale"/>
                <TranslateTransform x:Name="RunningTextTranslate"/>
              </TransformGroup>
            </TextBlock.RenderTransform>
          </TextBlock>
        </Grid>
        <Grid x:Name="CompletedLight" Width="16" Height="16" Visibility="Collapsed" ToolTip="已完成" RenderTransformOrigin="0.5,0.5">
          <Grid.RenderTransform><ScaleTransform x:Name="CompletedLightScale"/></Grid.RenderTransform>
          <Ellipse Fill="{StaticResource CompletedLightFill}" Stroke="#48FFFFFF" StrokeThickness="0.5"/>
          <TextBlock x:Name="CompletedLightText" Foreground="White" FontFamily="{x:Static ui:OverlayTypography.Number}" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <TextBlock.RenderTransform>
              <TransformGroup>
                <ScaleTransform x:Name="CompletedTextScale"/>
                <TranslateTransform x:Name="CompletedTextTranslate"/>
              </TransformGroup>
            </TextBlock.RenderTransform>
          </TextBlock>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</Window>
