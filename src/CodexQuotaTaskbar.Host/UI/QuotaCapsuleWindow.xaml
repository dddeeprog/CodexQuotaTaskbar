<Window x:Class="CodexQuotaTaskbar.Host.UI.QuotaCapsuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CodexQuotaTaskbar.Host.UI"
        Title="点岛" Width="280" Height="80"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        SnapsToDevicePixels="True" FontFamily="{x:Static ui:OverlayTypography.Text}" Typography.NumeralAlignment="Tabular">
  <!-- One 248-DIP surface for quotas and compact sessions. -->
  <Window.Resources>
    <LinearGradientBrush x:Key="WaitingLightFill" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FFFFA39E" Offset="0"/>
      <GradientStop Color="#F2FF5F57" Offset="0.56"/>
      <GradientStop Color="#D9C53F38" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RunningLightFill" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FFFFE19A" Offset="0"/>
      <GradientStop Color="#F2FEBC2E" Offset="0.56"/>
      <GradientStop Color="#D9B77A12" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CompletedLightFill" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FF98E7A6" Offset="0"/>
      <GradientStop Color="#F228C840" Offset="0.56"/>
      <GradientStop Color="#D918872B" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="LiquidProgress" TargetType="ProgressBar">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid Height="3">
              <Border Background="#24FFFFFF" CornerRadius="2" />
              <Grid x:Name="PART_Track">
                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="2" />
              </Grid>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PanelButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#F2F2F7"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#12FFFFFF"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#20FFFFFF"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid x:Name="Shell">
    <Border x:Name="BackdropLayer" Margin="16" CornerRadius="22" Background="#011D1D1F"/>
    <Border x:Name="GlassBorder" Margin="16" CornerRadius="22"
            Background="{x:Static ui:OverlayGlassMaterial.Surface}"
            BorderBrush="{x:Static ui:OverlayGlassMaterial.Border}" BorderThickness="0">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid x:Name="QuotaHeader" Margin="14,0,10,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid x:Name="FirstRow" Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="7"/></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="FirstLabel" Foreground="#D8D8DC" FontSize="10" FontWeight="Medium" VerticalAlignment="Center"/>
          <TextBlock x:Name="FirstValue" Grid.Column="1" Width="33" TextAlignment="Right" Foreground="#FAFFFFFF" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          <ProgressBar x:Name="FirstBar" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource LiquidProgress}" Minimum="0" Maximum="100" Foreground="#F2F2F7" VerticalAlignment="Bottom"/>
        </Grid>
        <Grid x:Name="SecondRow" Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="7"/></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="SecondLabel" Foreground="#D8D8DC" FontSize="10" FontWeight="Medium" VerticalAlignment="Center"/>
          <TextBlock x:Name="SecondValue" Grid.Column="1" Width="33" TextAlignment="Right" Foreground="#FAFFFFFF" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          <ProgressBar x:Name="SecondBar" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource LiquidProgress}" Minimum="0" Maximum="100" Foreground="#F2F2F7" VerticalAlignment="Bottom"/>
        </Grid>
          <Button x:Name="SessionToggle" Grid.Column="2" Height="32" Style="{StaticResource PanelButton}" Visibility="Collapsed" AutomationProperties.Name="收起会话">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Border x:Name="SessionBadge" Height="22" Padding="0"
            VerticalAlignment="Center"
            BorderThickness="0" Visibility="Collapsed"
            RenderTransformOrigin="0.5,0.5">
      <Border.RenderTransform><ScaleTransform x:Name="SessionBadgeScale"/></Border.RenderTransform>
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#0038383C" Offset="0"/>
          <GradientStop Color="#00171719" Offset="0.56"/>
          <GradientStop Color="#0029292D" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>

      <StackPanel Orientation="Horizontal">
        <Grid x:Name="WaitingLight" Width="16" Height="16" Margin="0,0,3,0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
          <Grid.ToolTip><ToolTip Content="待授权" FontFamily="{x:Static ui:OverlayTypography.Text}"/></Grid.ToolTip>
          <Grid.RenderTransform><ScaleTransform x:Name="WaitingLightScale"/></Grid.RenderTransform>
          <Ellipse Fill="{StaticResource WaitingLightFill}" Stroke="#48FFFFFF" StrokeThickness="0.5"/>
          <TextBlock x:Name="WaitingLightText" Foreground="White" FontFamily="{x:Static ui:OverlayTypography.Number}" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <TextBlock.RenderTransform>
              <TransformGroup>
                <ScaleTransform x:Name="WaitingTextScale"/>
                <TranslateTransform x:Name="WaitingTextTranslate"/>
              </TransformGroup>
            </TextBlock.RenderTransform>
          </TextBlock>
        </Grid>
        <Grid x:Name="RunningLight" Width="16" Height="16" Margin="0,0,3,0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
          <Grid.ToolTip><ToolTip Content="进行中" FontFamily="{x:Static ui:OverlayTypography.Text}"/></Grid.ToolTip>
          <Grid.RenderTransform><ScaleTransform x:Name="RunningLightScale"/></Grid.RenderTransform>
          <Ellipse Fill="{StaticResource RunningLightFill}" Stroke="#48FFFFFF" StrokeThickness="0.5"/>
          <TextBlock x:Name="RunningLightText" Foreground="#6B4300" FontFamily="{x:Static ui:OverlayTypography.Number}" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <TextBlock.RenderTransform>
              <TransformGroup>
                <ScaleTransform x:Name="RunningTextScale"/>
                <TranslateTransform x:Name="RunningTextTranslate"/>
              </TransformGroup>
            </TextBlock.RenderTransform>
          </TextBlock>
        </Grid>
        <Grid x:Name="CompletedLight" Width="16" Height="16" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
          <Grid.ToolTip><ToolTip Content="已完成" FontFamily="{x:Static ui:OverlayTypography.Text}"/></Grid.ToolTip>
          <Grid.RenderTransform><ScaleTransform x:Name="CompletedLightScale"/></Grid.RenderTransform>
          <Ellipse Fill="{StaticResource CompletedLightFill}" Stroke="#48FFFFFF" StrokeThickness="0.5"/>
          <TextBlock x:Name="CompletedLightText" Foreground="White" FontFamily="{x:Static ui:OverlayTypography.Number}" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <TextBlock.RenderTransform>
              <TransformGroup>
                <ScaleTransform x:Name="CompletedTextScale"/>
                <TranslateTransform x:Name="CompletedTextTranslate"/>
              </TransformGroup>
            </TextBlock.RenderTransform>
          </TextBlock>
        </Grid>
      </StackPanel>
    </Border>

              <Path x:Name="SessionChevron" Width="9" Height="5" Margin="6,0,2,0" Data="M 0,0 L 4.5,4.5 L 9,0" Stroke="#D8D8DC" StrokeThickness="1.3" RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform><RotateTransform x:Name="SessionChevronRotation" Angle="180"/></Path.RenderTransform>
              </Path>
            </StackPanel>
          </Button>
        </Grid>
        <Grid x:Name="PanelSessionsRegion" Grid.Row="1" Height="0" VerticalAlignment="Top" ClipToBounds="True" Margin="12,0,12,0">
          <Border BorderBrush="#28FFFFFF" BorderThickness="0,1,0,0" Padding="0,7,0,10">
            <ScrollViewer x:Name="PanelSessionsScroller" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="VerticalOnly">
              <StackPanel x:Name="PanelSessionsList"/>
            </ScrollViewer>
          </Border>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
