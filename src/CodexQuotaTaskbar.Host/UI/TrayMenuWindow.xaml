<Window x:Class="CodexQuotaTaskbar.Host.UI.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CodexQuotaTaskbar.Host.UI"
        Title="Codex 额度菜单" Width="276" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        FontFamily="{x:Static ui:OverlayTypography.Text}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale">
  <Window.Resources>
    <Style x:Key="MenuAction" TargetType="Button">
      <Setter Property="Height" Value="42"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Foreground" Value="#F4FFFFFF"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontFamily" Value="{x:Static ui:OverlayTypography.Text}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="12">
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#1FFFFFFF"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#29FFFFFF"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.68"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DangerAction" TargetType="Button" BasedOn="{StaticResource MenuAction}">
      <Setter Property="Foreground" Value="#FFFF7B86"/>
    </Style>
    <Style x:Key="MenuIcon" TargetType="Path">
      <Setter Property="Width" Value="18"/>
      <Setter Property="Height" Value="18"/>
      <Setter Property="Stretch" Value="Uniform"/>
      <Setter Property="Stroke" Value="#C8FFFFFF"/>
      <Setter Property="StrokeThickness" Value="1.55"/>
      <Setter Property="StrokeStartLineCap" Value="Round"/>
      <Setter Property="StrokeEndLineCap" Value="Round"/>
      <Setter Property="StrokeLineJoin" Value="Round"/>
      <Setter Property="Fill" Value="Transparent"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Border x:Name="BackdropLayer" CornerRadius="22">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#F01B1B1D" Offset="0"/>
          <GradientStop Color="#E52B2B2E" Offset="0.5"/>
          <GradientStop Color="#F0131315" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
    </Border>
    <Border x:Name="GlassBorder" CornerRadius="22" Background="#8A161618" BorderBrush="#4CFFFFFF" BorderThickness="1">
      <Grid Margin="10">
        <Grid.RowDefinitions>
          <RowDefinition Height="54"/>
          <RowDefinition Height="1"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="1"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="1"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="8,0,7,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Image Source="/CodexQuotaTaskbar;component/Assets/QuotaIslandIcon.png" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" Text="Codex 额度" Foreground="#FAFFFFFF" FontFamily="{x:Static ui:OverlayTypography.Display}" FontSize="14" FontWeight="Medium"/>
            <TextBlock x:Name="RunningText" Text="额度岛正在运行" Foreground="#A8FFFFFF" FontFamily="{x:Static ui:OverlayTypography.Text}" FontSize="11" Margin="0,2,0,0"/>
          </StackPanel>
          <Border x:Name="VersionBadge" Grid.Column="2" Padding="7,3" CornerRadius="8" Background="#14FFFFFF" VerticalAlignment="Center">
            <TextBlock x:Name="VersionText" Foreground="#AFFFFFFF" FontFamily="{x:Static ui:OverlayTypography.Text}" FontSize="10"/>
          </Border>
        </Grid>

        <Border Grid.Row="1" Background="#20FFFFFF" Margin="8,0"/>

        <StackPanel Grid.Row="2" Margin="0,5">
          <Button x:Name="RefreshButton" Style="{StaticResource MenuAction}" AutomationProperties.Name="立即刷新额度">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Path Style="{StaticResource MenuIcon}" Data="M16.5,6.5 C14,4 10,4 7.5,6.5 C4.8,9.2 4.8,13.8 7.5,16.5 C10.2,19.2 14.4,18.8 16.8,16 M16.5,3.5 L16.5,7.5 L12.5,7.5"/>
              <TextBlock Grid.Column="1" Text="立即刷新" VerticalAlignment="Center"/>
            </Grid>
          </Button>
          <Button x:Name="CheckUpdatesButton" Style="{StaticResource MenuAction}" AutomationProperties.Name="检查 GitHub 更新">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Path Style="{StaticResource MenuIcon}" Data="M10,3.5 L10,13.5 M6.5,10 L10,13.5 L13.5,10 M4,17 L16,17"/>
              <TextBlock Grid.Column="1" Text="检查更新" VerticalAlignment="Center"/>
            </Grid>
          </Button>
          <Button x:Name="OpenCodexButton" Style="{StaticResource MenuAction}" AutomationProperties.Name="打开 Codex">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Path Style="{StaticResource MenuIcon}" Data="M11,4 L17,4 L17,10 M17,4 L9,12 M14.5,11.5 L14.5,16.5 L4,16.5 L4,6 L9,6"/>
              <TextBlock Grid.Column="1" Text="打开 Codex" VerticalAlignment="Center"/>
            </Grid>
          </Button>
        </StackPanel>

        <Border Grid.Row="3" Background="#20FFFFFF" Margin="8,0"/>

        <StackPanel Grid.Row="4" Margin="0,5">
          <Button x:Name="AllTaskbarsButton" Style="{StaticResource MenuAction}" AutomationProperties.Name="在全部任务栏显示">
            <Grid><TextBlock Text="全部任务栏" VerticalAlignment="Center"/>
              <Border x:Name="AllTaskbarsTrack" Width="34" Height="20" CornerRadius="10" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="3">
                <Ellipse x:Name="AllTaskbarsKnob" Width="14" Height="14" Fill="#FFF7F7F8" HorizontalAlignment="Left"/>
              </Border>
            </Grid>
          </Button>
          <Button x:Name="NotificationsButton" Style="{StaticResource MenuAction}" AutomationProperties.Name="低额度提醒">
            <Grid><TextBlock Text="低额度提醒" VerticalAlignment="Center"/>
              <Border x:Name="NotificationsTrack" Width="34" Height="20" CornerRadius="10" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="3">
                <Ellipse x:Name="NotificationsKnob" Width="14" Height="14" Fill="#FFF7F7F8" HorizontalAlignment="Left"/>
              </Border>
            </Grid>
          </Button>
          <Button x:Name="AutomaticUpdatesButton" Style="{StaticResource MenuAction}" AutomationProperties.Name="自动更新">
            <Grid><TextBlock Text="自动更新" VerticalAlignment="Center"/>
              <Border x:Name="AutomaticUpdatesTrack" Width="34" Height="20" CornerRadius="10" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="3">
                <Ellipse x:Name="AutomaticUpdatesKnob" Width="14" Height="14" Fill="#FFF7F7F8" HorizontalAlignment="Left"/>
              </Border>
            </Grid>
          </Button>
          <Button x:Name="AutostartButton" Style="{StaticResource MenuAction}" AutomationProperties.Name="开机启动">
            <Grid><TextBlock Text="开机启动" VerticalAlignment="Center"/>
              <Border x:Name="AutostartTrack" Width="34" Height="20" CornerRadius="10" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="3">
                <Ellipse x:Name="AutostartKnob" Width="14" Height="14" Fill="#FFF7F7F8" HorizontalAlignment="Left"/>
              </Border>
            </Grid>
          </Button>
        </StackPanel>

        <Border Grid.Row="5" Background="#20FFFFFF" Margin="8,0"/>

        <Button x:Name="ExitButton" Grid.Row="6" Margin="0,5,0,0" Style="{StaticResource DangerAction}" AutomationProperties.Name="退出额度岛">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Path x:Name="ExitIcon" Width="18" Height="18" Stretch="Uniform" Stroke="#FFFF7B86" StrokeThickness="1.55" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M9,4 L4,4 L4,16 L9,16 M12,7 L15,10 L12,13 M7,10 L15,10"/>
            <TextBlock Grid.Column="1" Text="退出额度岛" VerticalAlignment="Center"/>
          </Grid>
        </Button>
      </Grid>
    </Border>
  </Grid>
</Window>
