<Window x:Class="CodexQuotaTaskbar.Host.UI.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CodexQuotaTaskbar.Host.UI"
        Title="点岛菜单" Width="272" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        FontFamily="{x:Static ui:OverlayTypography.Interface}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale" Typography.NumeralAlignment="Tabular">
  <Window.Resources>
    <Style x:Key="TransparencyTrackButton" TargetType="RepeatButton">
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
        <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" VerticalAlignment="Center"/>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="MaterialSlider" TargetType="Slider">
      <Setter Property="Height" Value="26"/>
      <Setter Property="Foreground" Value="#F4F4F6"/>
      <Setter Property="Background" Value="#38FFFFFF"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
        <Grid Background="Transparent">
          <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value}" IsDirectionReversed="False">
            <Track.DecreaseRepeatButton>
              <RepeatButton Style="{StaticResource TransparencyTrackButton}" Command="Slider.DecreaseLarge" Background="{TemplateBinding Foreground}"/>
            </Track.DecreaseRepeatButton>
            <Track.IncreaseRepeatButton>
              <RepeatButton Style="{StaticResource TransparencyTrackButton}" Command="Slider.IncreaseLarge" Background="{TemplateBinding Background}"/>
            </Track.IncreaseRepeatButton>
            <Track.Thumb>
              <Thumb Width="20" Height="26">
                <Thumb.Template><ControlTemplate TargetType="Thumb">
                  <Grid Background="Transparent">
                    <Ellipse Width="16" Height="16" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}"/>
                  </Grid>
                </ControlTemplate></Thumb.Template>
              </Thumb>
            </Track.Thumb>
          </Track>
          <Border x:Name="FocusRing" BorderBrush="{TemplateBinding Foreground}" BorderThickness="1" CornerRadius="7" Visibility="Collapsed" IsHitTestVisible="False"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="MenuAction" TargetType="Button">
      <EventSetter Event="MouseEnter" Handler="OnMenuItemMouseEnter"/>
      <EventSetter Event="GotKeyboardFocus" Handler="OnMenuItemFocus"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Foreground" Value="#F4FFFFFF"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontFamily" Value="{x:Static ui:OverlayTypography.Interface}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6">
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>

              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="1"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.68"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DangerAction" TargetType="Button" BasedOn="{StaticResource MenuAction}">
      <Setter Property="Foreground" Value="#FFFF7B86"/>
    </Style>
    <Style x:Key="MenuIcon" TargetType="Path">
      <Setter Property="Width" Value="15"/>
      <Setter Property="Height" Value="15"/>
      <Setter Property="Stretch" Value="Uniform"/>
      <Setter Property="Stroke" Value="#C8FFFFFF"/>
      <Setter Property="StrokeThickness" Value="1.4"/>
      <Setter Property="StrokeStartLineCap" Value="Round"/>
      <Setter Property="StrokeEndLineCap" Value="Round"/>
      <Setter Property="StrokeLineJoin" Value="Round"/>
      <Setter Property="Fill" Value="Transparent"/>
    </Style>
  </Window.Resources>

  <Grid x:Name="MenuShell" Margin="10" MouseLeave="OnMenuMouseLeave">
    <Border x:Name="SurfaceShadow" CornerRadius="12" Background="Transparent" BorderBrush="#50000000" BorderThickness="1" IsHitTestVisible="False"><Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.2"/></Border.Effect></Border>
    <Border x:Name="BackdropLayer" CornerRadius="12" Background="#011D1D1F"/>
    <Border x:Name="GlassBorder" CornerRadius="12" Background="{x:Static ui:OverlayGlassMaterial.Surface}" BorderBrush="{x:Static ui:OverlayGlassMaterial.Border}" BorderThickness="0.5">
      <ScrollViewer x:Name="MenuScroller" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"><Grid x:Name="MenuContent" Margin="6">
        <Canvas IsHitTestVisible="False"><Border x:Name="MenuHighlight" Width="1" Height="32" CornerRadius="6" Background="#1FFFFFFF" Opacity="0"><Border.RenderTransform><TranslateTransform x:Name="MenuHighlightTranslate"/></Border.RenderTransform></Border></Canvas>
        <StackPanel x:Name="MenuItems">
        <Grid Margin="10,8,10,10"><TextBlock x:Name="TitleText" Text="点岛" Foreground="#FAFFFFFF" FontSize="13" FontWeight="Medium"/><Border x:Name="VersionBadge" HorizontalAlignment="Right"><TextBlock x:Name="VersionText" Foreground="#B5B5BA" FontSize="11"/></Border></Grid>
        <Button x:Name="DotChatButton" Style="{StaticResource MenuAction}" AutomationProperties.Name="查看 Dot 消息"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Style="{StaticResource MenuIcon}" Data="M3,3 L17,3 L17,13 L8,13 L3,17 Z M6,7 L14,7 M6,10 L11,10"/><TextBlock Grid.Column="1" Text="Dot 消息" VerticalAlignment="Center"/></Grid></Button>
        <Button x:Name="DotRealtimeButton" Style="{StaticResource MenuAction}" AutomationProperties.Name="Dot 实时接收" AutomationProperties.HelpText="关闭后释放 Dot 浏览器内存，停止接收新消息"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path x:Name="DotRealtimeCheck" Width="12" Height="9" VerticalAlignment="Center" HorizontalAlignment="Left" Stretch="Uniform" Data="M0,5 L5,10 L14,0" Stroke="#F2F2F7" StrokeThickness="1.5"/><TextBlock Grid.Column="1" Text="Dot 实时接收" VerticalAlignment="Center"/></Grid></Button>
        <Button x:Name="OpenCodexButton" Style="{StaticResource MenuAction}" AutomationProperties.Name="打开 Codex"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Style="{StaticResource MenuIcon}" Data="M11,4 L17,4 L17,10 M17,4 L9,12 M14.5,11.5 L14.5,16.5 L4,16.5 L4,6 L9,6"/><TextBlock Grid.Column="1" Text="打开 Codex" VerticalAlignment="Center"/></Grid></Button>
        <Button x:Name="RefreshButton" Style="{StaticResource MenuAction}" AutomationProperties.Name="立即刷新"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Style="{StaticResource MenuIcon}" Data="M16.5,6.5 C14,4 10,4 7.5,6.5 C4.8,9.2 4.8,13.8 7.5,16.5 C10.2,19.2 14.4,18.8 16.8,16 M16.5,3.5 L16.5,7.5 L12.5,7.5"/><TextBlock Grid.Column="1" Text="立即刷新" VerticalAlignment="Center"/></Grid></Button>
        <Button x:Name="SubscriptionLoginButton" Style="{StaticResource MenuAction}" AutomationProperties.Name="网页登录订阅…"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Style="{StaticResource MenuIcon}" Data="M4,5 L17,5 L17,17 L4,17 Z M4,9 L17,9 M7,7 L8,7"/><TextBlock Grid.Column="1" Text="网页登录订阅…" VerticalAlignment="Center"/></Grid></Button>
        <Border Height="0.5" Background="#28FFFFFF" Margin="10,5"/>
        <Button x:Name="AppearanceButton" Style="{StaticResource MenuAction}" AutomationProperties.Name="外观"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Style="{StaticResource MenuIcon}" Data="M3,4 L17,4 L17,17 L3,17 Z M3,8 L17,8 M8,8 L8,17"/><TextBlock Grid.Column="1" Text="外观" VerticalAlignment="Center"/><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="StyleSummaryText" FontSize="11" Foreground="#B5B5BA" Margin="4,0,7,0"/><Path x:Name="AppearanceChevron" RenderTransformOrigin="0.5,0.5" Width="5" Height="9" Stretch="Uniform" Stroke="#B5B5BA" StrokeThickness="1.3" Data="M0,0 L5,5 L0,10"><Path.RenderTransform><RotateTransform x:Name="AppearanceChevronRotation"/></Path.RenderTransform></Path></StackPanel></Grid></Button>
        <Border x:Name="AppearanceReveal" Height="0" ClipToBounds="True" IsHitTestVisible="False" Focusable="False"><Grid x:Name="AppearanceRoot" TextElement.FontFamily="{x:Static ui:OverlayTypography.Interface}" TextElement.FontSize="13" TextElement.Foreground="#F4FFFFFF" KeyboardNavigation.TabNavigation="Cycle"><Border x:Name="AppearanceGlass" CornerRadius="12" Background="Transparent" BorderBrush="#28FFFFFF" BorderThickness="1,0,0,0" Margin="12,2,0,5"><ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="5,2,0,2"><TextBlock Text="显示样式" Tag="secondary" Foreground="#B5B5BA" FontSize="12" Margin="10,6,10,5"/><Button x:Name="ClassicStyleButton" Style="{StaticResource MenuAction}" AutomationProperties.Name="经典气泡"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path x:Name="ClassicStyleCheck" Width="12" Height="9" VerticalAlignment="Center" HorizontalAlignment="Left" Stretch="Uniform" Data="M0,5 L5,10 L14,0" Stroke="#F2F2F7" StrokeThickness="1.5"/><TextBlock Grid.Column="1" Text="经典气泡" VerticalAlignment="Center"/></Grid></Button><Button x:Name="UnifiedStyleButton" Style="{StaticResource MenuAction}" AutomationProperties.Name="一体面板"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path x:Name="UnifiedStyleCheck" Width="12" Height="9" VerticalAlignment="Center" HorizontalAlignment="Left" Stretch="Uniform" Data="M0,5 L5,10 L14,0" Stroke="#F2F2F7" StrokeThickness="1.5"/><TextBlock Grid.Column="1" Text="一体面板" VerticalAlignment="Center"/></Grid></Button><Border Height="0.5" Background="#28FFFFFF" Margin="10,5"/><StackPanel Margin="10,8,10,8"><Grid><TextBlock x:Name="MaterialTransparencyLabel" Text="材质透明度" FontSize="13"/><TextBlock x:Name="MaterialTransparencyValue" Text="0%" HorizontalAlignment="Right" FontSize="12"/></Grid><Slider x:Name="MaterialTransparencySlider" Style="{StaticResource MaterialSlider}" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" AutomationProperties.Name="材质透明度" AutomationProperties.HelpText="0% 不透明，100% 全透明；只影响背景，不改变文字和图标"/><TextBlock x:Name="MaterialTransparencyHint" Text="0% 不透明 · 100% 全透明" Foreground="#B8FFFFFF" FontSize="11" TextWrapping="Wrap"/></StackPanel><Border Height="0.5" Background="#28FFFFFF" Margin="10,5"/><Button x:Name="AllTaskbarsButton" Style="{StaticResource MenuAction}" AutomationProperties.Name="在全部任务栏显示"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path x:Name="AllTaskbarsCheck" Width="12" Height="9" VerticalAlignment="Center" HorizontalAlignment="Left" Stretch="Uniform" Data="M0,5 L5,10 L14,0" Stroke="#F2F2F7" StrokeThickness="1.5"/><TextBlock Grid.Column="1" Text="在全部任务栏显示" VerticalAlignment="Center"/></Grid></Button></StackPanel></ScrollViewer></Border></Grid></Border>
        <Button x:Name="PreferencesButton" Style="{StaticResource MenuAction}" AutomationProperties.Name="偏好设置"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Style="{StaticResource MenuIcon}" Data="M3,5 L17,5 M3,10 L17,10 M3,15 L17,15 M6,3 L6,7 M13,8 L13,12 M8,13 L8,17"/><TextBlock Grid.Column="1" Text="偏好设置" VerticalAlignment="Center"/><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Path x:Name="PreferencesChevron" RenderTransformOrigin="0.5,0.5" Width="5" Height="9" Stretch="Uniform" Stroke="#B5B5BA" StrokeThickness="1.3" Data="M0,0 L5,5 L0,10"><Path.RenderTransform><RotateTransform x:Name="PreferencesChevronRotation"/></Path.RenderTransform></Path></StackPanel></Grid></Button>
        <Border x:Name="PreferencesReveal" Height="0" ClipToBounds="True" IsHitTestVisible="False" Focusable="False"><Grid x:Name="PreferencesRoot" TextElement.FontFamily="{x:Static ui:OverlayTypography.Interface}" TextElement.FontSize="13" TextElement.Foreground="#F4FFFFFF" KeyboardNavigation.TabNavigation="Cycle"><Border x:Name="PreferencesGlass" CornerRadius="12" Background="Transparent" BorderBrush="#28FFFFFF" BorderThickness="1,0,0,0" Margin="12,2,0,5"><ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="5,2,0,2"><TextBlock Text="偏好设置" Tag="secondary" Foreground="#B5B5BA" FontSize="12" Margin="10,6,10,5"/><Button x:Name="TrayIconButton" Style="{StaticResource MenuAction}" AutomationProperties.Name="显示托盘图标" AutomationProperties.HelpText="关闭后可右键点岛恢复；托盘气泡通知将暂停"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path x:Name="TrayIconCheck" Width="12" Height="9" VerticalAlignment="Center" HorizontalAlignment="Left" Stretch="Uniform" Data="M0,5 L5,10 L14,0" Stroke="#F2F2F7" StrokeThickness="1.5"/><TextBlock Grid.Column="1" Text="显示托盘图标" VerticalAlignment="Center"/></Grid></Button><Button x:Name="NotificationsButton" Style="{StaticResource MenuAction}" AutomationProperties.Name="低额度提醒"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path x:Name="NotificationsCheck" Width="12" Height="9" VerticalAlignment="Center" HorizontalAlignment="Left" Stretch="Uniform" Data="M0,5 L5,10 L14,0" Stroke="#F2F2F7" StrokeThickness="1.5"/><TextBlock Grid.Column="1" Text="低额度提醒" VerticalAlignment="Center"/></Grid></Button><Button x:Name="SubscriptionDetailsButton" Style="{StaticResource MenuAction}" AutomationProperties.Name="显示订阅有效期"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path x:Name="SubscriptionDetailsCheck" Width="12" Height="9" VerticalAlignment="Center" HorizontalAlignment="Left" Stretch="Uniform" Data="M0,5 L5,10 L14,0" Stroke="#F2F2F7" StrokeThickness="1.5"/><TextBlock Grid.Column="1" Text="显示订阅有效期" VerticalAlignment="Center"/></Grid></Button><Border Height="0.5" Background="#28FFFFFF" Margin="10,5"/><Button x:Name="AutomaticUpdatesButton" Style="{StaticResource MenuAction}" AutomationProperties.Name="自动更新"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path x:Name="AutomaticUpdatesCheck" Width="12" Height="9" VerticalAlignment="Center" HorizontalAlignment="Left" Stretch="Uniform" Data="M0,5 L5,10 L14,0" Stroke="#F2F2F7" StrokeThickness="1.5"/><TextBlock Grid.Column="1" Text="自动更新" VerticalAlignment="Center"/></Grid></Button><Button x:Name="AutostartButton" Style="{StaticResource MenuAction}" AutomationProperties.Name="开机启动"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path x:Name="AutostartCheck" Width="12" Height="9" VerticalAlignment="Center" HorizontalAlignment="Left" Stretch="Uniform" Data="M0,5 L5,10 L14,0" Stroke="#F2F2F7" StrokeThickness="1.5"/><TextBlock Grid.Column="1" Text="开机启动" VerticalAlignment="Center"/></Grid></Button></StackPanel></ScrollViewer></Border></Grid></Border>
        <Border Height="0.5" Background="#28FFFFFF" Margin="10,5"/>
        <Button x:Name="CheckUpdatesButton" Style="{StaticResource MenuAction}" AutomationProperties.Name="检查更新…"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Style="{StaticResource MenuIcon}" Data="M10,3.5 L10,13.5 M6.5,10 L10,13.5 L13.5,10 M4,17 L16,17"/><TextBlock Grid.Column="1" Text="检查更新…" VerticalAlignment="Center"/></Grid></Button>
        <Button x:Name="ExitButton" Style="{StaticResource DangerAction}" AutomationProperties.Name="退出点岛"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path x:Name="ExitIcon" Style="{StaticResource MenuIcon}" Data="M9,4 L4,4 L4,16 L9,16 M12,7 L15,10 L12,13 M7,10 L15,10"/><TextBlock Grid.Column="1" Text="退出点岛" VerticalAlignment="Center"/></Grid></Button>
      </StackPanel></Grid></ScrollViewer>
    </Border>


  </Grid>
</Window>
