<Window x:Class="CodexQuotaTaskbar.Host.UI.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CodexQuotaTaskbar.Host.UI"
        Title="Codex 额度菜单" Width="276" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        FontFamily="{x:Static ui:OverlayTypography.Text}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale">
  <Window.Resources>
    <Style x:Key="TransparencyTrackButton" TargetType="RepeatButton">
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
        <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" VerticalAlignment="Center"/>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="MaterialSlider" TargetType="Slider">
      <Setter Property="Height" Value="30"/>
      <Setter Property="Foreground" Value="#F4F4F6"/>
      <Setter Property="Background" Value="#38FFFFFF"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
        <Grid Background="Transparent">
          <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value}" IsDirectionReversed="False">
            <Track.DecreaseRepeatButton>
              <RepeatButton Style="{StaticResource TransparencyTrackButton}" Command="Slider.DecreaseLarge" Background="{TemplateBinding Foreground}"/>
            </Track.DecreaseRepeatButton>
            <Track.IncreaseRepeatButton>
              <RepeatButton Style="{StaticResource TransparencyTrackButton}" Command="Slider.IncreaseLarge" Background="{TemplateBinding Background}"/>
            </Track.IncreaseRepeatButton>
            <Track.Thumb>
              <Thumb Width="20" Height="26">
                <Thumb.Template><ControlTemplate TargetType="Thumb">
                  <Grid Background="Transparent">
                    <Ellipse Width="16" Height="16" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}"/>
                  </Grid>
                </ControlTemplate></Thumb.Template>
              </Thumb>
            </Track.Thumb>
          </Track>
          <Border x:Name="FocusRing" BorderBrush="{TemplateBinding Foreground}" BorderThickness="1" CornerRadius="7" Visibility="Collapsed" IsHitTestVisible="False"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="MenuAction" TargetType="Button">
      <Setter Property="Height" Value="42"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Foreground" Value="#F4FFFFFF"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontFamily" Value="{x:Static ui:OverlayTypography.Text}"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="12">
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#1FFFFFFF"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#29FFFFFF"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.68"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DangerAction" TargetType="Button" BasedOn="{StaticResource MenuAction}">
      <Setter Property="Foreground" Value="#FFFF7B86"/>
    </Style>
    <Style x:Key="MenuIcon" TargetType="Path">
      <Setter Property="Width" Value="18"/>
      <Setter Property="Height" Value="18"/>
      <Setter Property="Stretch" Value="Uniform"/>
      <Setter Property="Stroke" Value="#C8FFFFFF"/>
      <Setter Property="StrokeThickness" Value="1.55"/>
      <Setter Property="StrokeStartLineCap" Value="Round"/>
      <Setter Property="StrokeEndLineCap" Value="Round"/>
      <Setter Property="StrokeLineJoin" Value="Round"/>
      <Setter Property="Fill" Value="Transparent"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Border x:Name="BackdropLayer" CornerRadius="22" Background="#011D1D1F"/>
    <Border x:Name="GlassBorder" CornerRadius="22" Background="{x:Static ui:OverlayGlassMaterial.Surface}" BorderBrush="{x:Static ui:OverlayGlassMaterial.Border}" BorderThickness="1">
      <ScrollViewer x:Name="MenuScroller" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
      <Grid Margin="10">
        <Grid.RowDefinitions>
          <RowDefinition Height="54"/>
          <RowDefinition Height="1"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="1"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="1"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="8,0,7,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Image Source="/CodexQuotaTaskbar;component/Assets/QuotaIslandIcon.png" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" Text="Codex 额度" Foreground="#FAFFFFFF" FontFamily="{x:Static ui:OverlayTypography.Display}" FontSize="14" FontWeight="SemiBold"/>
            <TextBlock x:Name="RunningText" Text="额度岛正在运行" Foreground="#A8FFFFFF" FontFamily="{x:Static ui:OverlayTypography.Text}" FontSize="11.5" Margin="0,2,0,0"/>
          </StackPanel>
          <Border x:Name="VersionBadge" Grid.Column="2" Padding="7,3" CornerRadius="8" Background="#14FFFFFF" VerticalAlignment="Center">
            <TextBlock x:Name="VersionText" Foreground="#AFFFFFFF" FontFamily="{x:Static ui:OverlayTypography.Text}" FontSize="10"/>
          </Border>
        </Grid>

        <Border Grid.Row="1" Background="#20FFFFFF" Margin="8,0"/>

        <StackPanel Grid.Row="2" Margin="0,5">
          <Button x:Name="RefreshButton" Style="{StaticResource MenuAction}" AutomationProperties.Name="立即刷新额度">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Path Style="{StaticResource MenuIcon}" Data="M16.5,6.5 C14,4 10,4 7.5,6.5 C4.8,9.2 4.8,13.8 7.5,16.5 C10.2,19.2 14.4,18.8 16.8,16 M16.5,3.5 L16.5,7.5 L12.5,7.5"/>
              <TextBlock Grid.Column="1" Text="立即刷新" VerticalAlignment="Center"/>
            </Grid>
          </Button>
          <Button x:Name="CheckUpdatesButton" Style="{StaticResource MenuAction}" AutomationProperties.Name="检查 GitHub 更新">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Path Style="{StaticResource MenuIcon}" Data="M10,3.5 L10,13.5 M6.5,10 L10,13.5 L13.5,10 M4,17 L16,17"/>
              <TextBlock Grid.Column="1" Text="检查更新" VerticalAlignment="Center"/>
            </Grid>
          </Button>
          <Button x:Name="SubscriptionLoginButton" Style="{StaticResource MenuAction}" AutomationProperties.Name="网页登录订阅">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Path Style="{StaticResource MenuIcon}" Data="M4,5 L17,5 L17,17 L4,17 Z M4,9 L17,9 M7,7 L8,7"/>
              <TextBlock Grid.Column="1" Text="网页登录订阅" VerticalAlignment="Center"/>
            </Grid>
          </Button>
          <Button x:Name="OpenCodexButton" Style="{StaticResource MenuAction}" AutomationProperties.Name="打开 Codex">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Path Style="{StaticResource MenuIcon}" Data="M11,4 L17,4 L17,10 M17,4 L9,12 M14.5,11.5 L14.5,16.5 L4,16.5 L4,6 L9,6"/>
              <TextBlock Grid.Column="1" Text="打开 Codex" VerticalAlignment="Center"/>
            </Grid>
          </Button>
        </StackPanel>

        <Border Grid.Row="3" Background="#20FFFFFF" Margin="8,0"/>

        <StackPanel Grid.Row="4" Margin="0,5">
          <StackPanel Margin="12,7,12,8">
            <Grid>
              <TextBlock x:Name="MaterialTransparencyLabel" Text="材质透明度" Foreground="#F4FFFFFF" FontSize="13.5" FontWeight="SemiBold"/>
              <TextBlock x:Name="MaterialTransparencyValue" Text="0%" HorizontalAlignment="Right" Foreground="#F4FFFFFF" FontSize="12"/>
            </Grid>
            <Slider x:Name="MaterialTransparencySlider" Style="{StaticResource MaterialSlider}" Minimum="0" Maximum="100"
                    SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                    AutomationProperties.Name="材质透明度" AutomationProperties.HelpText="0% 不透明，100% 全透明；只影响背景，不改变文字和图标"/>
            <TextBlock x:Name="MaterialTransparencyHint" Text="0% 不透明 · 100% 全透明" Foreground="#B8FFFFFF" FontSize="10.5" TextWrapping="Wrap"/>
          </StackPanel>
          <Button x:Name="AllTaskbarsButton" Style="{StaticResource MenuAction}" AutomationProperties.Name="在全部任务栏显示">
            <Grid><TextBlock Text="全部任务栏" VerticalAlignment="Center"/>
              <Border x:Name="AllTaskbarsTrack" Width="34" Height="20" CornerRadius="10" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="3">
                <Ellipse x:Name="AllTaskbarsKnob" Width="14" Height="14" Fill="#FFF7F7F8" HorizontalAlignment="Left"/>
              </Border>
            </Grid>
          </Button>
          <Button x:Name="NotificationsButton" Style="{StaticResource MenuAction}" AutomationProperties.Name="低额度提醒">
            <Grid><TextBlock Text="低额度提醒" VerticalAlignment="Center"/>
              <Border x:Name="NotificationsTrack" Width="34" Height="20" CornerRadius="10" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="3">
                <Ellipse x:Name="NotificationsKnob" Width="14" Height="14" Fill="#FFF7F7F8" HorizontalAlignment="Left"/>
              </Border>
            </Grid>
          </Button>
          <Button x:Name="AutomaticUpdatesButton" Style="{StaticResource MenuAction}" AutomationProperties.Name="自动更新">
            <Grid><TextBlock Text="自动更新" VerticalAlignment="Center"/>
              <Border x:Name="AutomaticUpdatesTrack" Width="34" Height="20" CornerRadius="10" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="3">
                <Ellipse x:Name="AutomaticUpdatesKnob" Width="14" Height="14" Fill="#FFF7F7F8" HorizontalAlignment="Left"/>
              </Border>
            </Grid>
          </Button>
          <Button x:Name="SubscriptionDetailsButton" Style="{StaticResource MenuAction}" AutomationProperties.Name="读取订阅有效期">
            <Grid><TextBlock Text="订阅有效期" VerticalAlignment="Center"/>
              <Border x:Name="SubscriptionDetailsTrack" Width="34" Height="20" CornerRadius="10" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="3">
                <Ellipse x:Name="SubscriptionDetailsKnob" Width="14" Height="14" Fill="#FFF7F7F8" HorizontalAlignment="Left"/>
              </Border>
            </Grid>
          </Button>
          <Button x:Name="AutostartButton" Style="{StaticResource MenuAction}" AutomationProperties.Name="开机启动">
            <Grid><TextBlock Text="开机启动" VerticalAlignment="Center"/>
              <Border x:Name="AutostartTrack" Width="34" Height="20" CornerRadius="10" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="3">
                <Ellipse x:Name="AutostartKnob" Width="14" Height="14" Fill="#FFF7F7F8" HorizontalAlignment="Left"/>
              </Border>
            </Grid>
          </Button>
        </StackPanel>

        <Border Grid.Row="5" Background="#20FFFFFF" Margin="8,0"/>

        <Button x:Name="ExitButton" Grid.Row="6" Margin="0,5,0,0" Style="{StaticResource DangerAction}" AutomationProperties.Name="退出额度岛">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Path x:Name="ExitIcon" Width="18" Height="18" Stretch="Uniform" Stroke="#FFFF7B86" StrokeThickness="1.55" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M9,4 L4,4 L4,16 L9,16 M12,7 L15,10 L12,13 M7,10 L15,10"/>
            <TextBlock Grid.Column="1" Text="退出额度岛" VerticalAlignment="Center"/>
          </Grid>
        </Button>
      </Grid>
      </ScrollViewer>
    </Border>
  </Grid>
</Window>
