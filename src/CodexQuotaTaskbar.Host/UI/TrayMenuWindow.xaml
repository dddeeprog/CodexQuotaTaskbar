<Window x:Class="CodexQuotaTaskbar.Host.UI.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CodexQuotaTaskbar.Host.UI"
        Title="点岛菜单" Width="272" SizeToContent="Height" MaxHeight="460"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        FontFamily="{x:Static ui:OverlayTypography.Interface}" FontWeight="SemiBold"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale" Typography.NumeralAlignment="Tabular">
  <Window.Resources>
    <SolidColorBrush x:Key="MenuSegmentTrackBrush" Color="#18000000"/>
    <SolidColorBrush x:Key="MenuSelectedBrush" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="MenuChoiceBorderBrush" Color="#18FFFFFF"/>
    <SolidColorBrush x:Key="MenuHoverBrush" Color="#0EFFFFFF"/>
    <SolidColorBrush x:Key="MenuSwitchOffBrush" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="MenuSwitchOnBrush" Color="#95BBB7"/>
    <SolidColorBrush x:Key="MenuSwitchThumbBrush" Color="#DDE0E4"/>
    <SolidColorBrush x:Key="MenuSwitchOnThumbBrush" Color="#FFFFFF"/>

    <Style x:Key="TransparencyTrackButton" TargetType="RepeatButton">
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
        <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" VerticalAlignment="Center"/>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="MaterialSlider" TargetType="Slider">
      <Setter Property="Height" Value="32"/>
      <Setter Property="Foreground" Value="#F4F4F6"/>
      <Setter Property="Background" Value="#38FFFFFF"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
        <Grid Background="Transparent">
          <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value}" IsDirectionReversed="False">
            <Track.DecreaseRepeatButton>
              <RepeatButton Style="{StaticResource TransparencyTrackButton}" Command="Slider.DecreaseLarge" Background="{TemplateBinding Foreground}"/>
            </Track.DecreaseRepeatButton>
            <Track.IncreaseRepeatButton>
              <RepeatButton Style="{StaticResource TransparencyTrackButton}" Command="Slider.IncreaseLarge" Background="{TemplateBinding Background}"/>
            </Track.IncreaseRepeatButton>
            <Track.Thumb>
              <Thumb Width="20" Height="26">
                <Thumb.Template><ControlTemplate TargetType="Thumb">
                  <Grid Background="Transparent">
                    <Ellipse Width="16" Height="16" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}"/>
                  </Grid>
                </ControlTemplate></Thumb.Template>
              </Thumb>
            </Track.Thumb>
          </Track>
          <Border x:Name="FocusRing" BorderBrush="{TemplateBinding Foreground}" BorderThickness="1" CornerRadius="7" Visibility="Collapsed" IsHitTestVisible="False"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="MenuAction" TargetType="Button">
      <EventSetter Event="MouseEnter" Handler="OnMenuItemMouseEnter"/>
      <EventSetter Event="GotKeyboardFocus" Handler="OnMenuItemFocus"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Foreground" Value="#F4FFFFFF"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontFamily" Value="{x:Static ui:OverlayTypography.Interface}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6">
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource MenuHoverBrush}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.42"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource MenuChoiceBorderBrush}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="1"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.68"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DangerAction" TargetType="Button" BasedOn="{StaticResource MenuAction}">
      <Setter Property="Foreground" Value="#FFFF7B86"/>
    </Style>
    <Style x:Key="MenuIcon" TargetType="Path">
      <Setter Property="Width" Value="16"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="Stretch" Value="Uniform"/>
      <Setter Property="Stroke" Value="#C8FFFFFF"/>
      <Setter Property="StrokeThickness" Value="1.25"/>
      <Setter Property="StrokeStartLineCap" Value="Round"/>
      <Setter Property="StrokeEndLineCap" Value="Round"/>
      <Setter Property="StrokeLineJoin" Value="Round"/>
      <Setter Property="Fill" Value="Transparent"/>
    </Style>

    <Style x:Key="ChoiceAction" TargetType="Button" BasedOn="{StaticResource MenuAction}">
      <Setter Property="Margin" Value="1,0"/>
      <Setter Property="Padding" Value="6,0"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ChoiceChrome" CornerRadius="5" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
          <Grid><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Path x:Name="SelectedTick" Visibility="Collapsed"/>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChoiceChrome" Property="Background" Value="{DynamicResource MenuHoverBrush}"/></Trigger>
          <Trigger Property="Tag" Value="Selected"><Setter TargetName="ChoiceChrome" Property="Background" Value="{DynamicResource MenuSelectedBrush}"/><Setter TargetName="ChoiceChrome" Property="BorderBrush" Value="{DynamicResource MenuChoiceBorderBrush}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ChoiceChrome" Property="BorderBrush" Value="{DynamicResource MenuChoiceBorderBrush}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="ChoiceChrome" Property="Opacity" Value="0.68"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SegmentTrack" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource MenuSegmentTrackBrush}"/><Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="3"/><Setter Property="Margin" Value="4,0,4,6"/>
    </Style>
    <Style x:Key="SwitchTrack" TargetType="Border">
      <Setter Property="Width" Value="30"/><Setter Property="Height" Value="16"/><Setter Property="CornerRadius" Value="8"/>
      <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Background" Value="{DynamicResource MenuSwitchOffBrush}"/>
      <Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="On"><Setter Property="Background" Value="{DynamicResource MenuSwitchOnBrush}"/></DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="SwitchThumb" TargetType="Border">
      <Setter Property="Width" Value="12"/><Setter Property="Height" Value="12"/><Setter Property="CornerRadius" Value="6"/>
      <Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="2,0"/>
      <Setter Property="Background" Value="{DynamicResource MenuSwitchThumbBrush}"/>
      <Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="On"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Background" Value="{DynamicResource MenuSwitchOnThumbBrush}"/></DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="SwitchOffThumb" TargetType="Border" BasedOn="{StaticResource SwitchThumb}">
      <Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="On"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="BinaryAction" TargetType="Button" BasedOn="{StaticResource MenuAction}">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Chrome" CornerRadius="6" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
          <Grid Margin="9,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ContentPresenter VerticalAlignment="Center"/>
            <Border Grid.Column="1" Style="{StaticResource SwitchTrack}"><Border Style="{StaticResource SwitchThumb}"/></Border>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource MenuHoverBrush}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource MenuChoiceBorderBrush}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.68"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.42"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="MenuVerticalScrollBar" TargetType="ScrollBar">
      <Setter Property="Width" Value="12"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#68FFFFFF"/>
      <Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Grid Background="Transparent" Margin="0,4">
          <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical"
                 Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
            <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
            <Track.Thumb><Thumb MinHeight="24" Background="Transparent">
              <Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent">
                <Border x:Name="ScrollbarThumbVisual" Width="3" CornerRadius="1.5" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ScrollBar}}"
                        Opacity="{Binding ScrollbarVisualOpacity, RelativeSource={RelativeSource AncestorType={x:Type ui:TrayMenuWindow}}}"/>
              </Grid></ControlTemplate></Thumb.Template>
            </Thumb></Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
          </Track>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="MenuScrollViewer" TargetType="ScrollViewer">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollViewer">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="{TemplateBinding CanContentScroll}"/>
          <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical" MinWidth="0" Width="12" MaxWidth="12"
                     Style="{StaticResource MenuVerticalScrollBar}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                     Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                     Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"/>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid x:Name="MenuShell" Margin="10" MouseLeave="OnMenuMouseLeave">
    <Border x:Name="SurfaceShadow" CornerRadius="12" Background="Transparent" BorderBrush="#50000000" BorderThickness="1" IsHitTestVisible="False"><Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.2"/></Border.Effect></Border>
    <Border x:Name="BackdropLayer" CornerRadius="12" Background="#011D1D1F"/>
    <Border x:Name="GlassBorder" CornerRadius="12" Background="{x:Static ui:OverlayGlassMaterial.Surface}" BorderBrush="{x:Static ui:OverlayGlassMaterial.Border}" BorderThickness="0.5">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid x:Name="MenuHeader"><Grid x:Name="PrimaryHeader" Margin="10,8,10,10"><TextBlock x:Name="TitleText" Text="点岛" Foreground="#FAFFFFFF" FontSize="13" FontWeight="SemiBold"/><Border x:Name="VersionBadge" HorizontalAlignment="Right"><TextBlock x:Name="VersionText" Foreground="#B5B5BA" FontSize="11"/></Border></Grid><Border x:Name="PageHeader" Visibility="Collapsed" BorderBrush="#28FFFFFF" BorderThickness="0,0,0,0.5" Margin="6,0">
          <Grid Margin="4,4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button x:Name="PageBackButton" Style="{StaticResource MenuAction}" Width="64" Padding="4,0" AutomationProperties.Name="返回主菜单"><TextBlock><Run Text="‹" FontWeight="Normal"/><Run Text=" 返回" FontWeight="SemiBold"/></TextBlock></Button>
            <TextBlock x:Name="PageTitleText" Grid.Column="1" Text="外观与互动" Foreground="#FAFFFFFF" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>
</Grid>
        </Border></Grid>
        <ScrollViewer x:Name="MenuScroller" Grid.Row="1" Style="{StaticResource MenuScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
          <Grid x:Name="MenuContent" Margin="6">
            <Canvas IsHitTestVisible="False"><Border x:Name="MenuHighlight" Width="1" Height="32" CornerRadius="6" Background="#1FFFFFFF" Opacity="0"><Border.RenderTransform><TranslateTransform x:Name="MenuHighlightTranslate"/></Border.RenderTransform></Border></Canvas>
            <StackPanel x:Name="MenuItems">
              
<Button x:Name="OpenCodexButton" Style="{StaticResource MenuAction}" AutomationProperties.Name="打开 Codex"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Style="{StaticResource MenuIcon}" Data="M11,4 L17,4 L17,10 M17,4 L9,12 M14.5,11.5 L14.5,16.5 L4,16.5 L4,6 L9,6"/><TextBlock Margin="8,0,0,0" Grid.Column="1" Text="打开 Codex" VerticalAlignment="Center"/></Grid></Button>
<Button x:Name="OpenWorkbenchButton" Style="{StaticResource MenuAction}" Visibility="Collapsed" IsEnabled="False" AutomationProperties.Name="项目工作台"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Style="{StaticResource MenuIcon}" Data="M3,4 L17,4 L17,16 L3,16 Z M3,8 L17,8 M8,8 L8,16"/><TextBlock Grid.Column="1" Margin="8,0,0,0" Text="项目工作台" VerticalAlignment="Center"/></Grid></Button>
<Button x:Name="RefreshButton" Style="{StaticResource MenuAction}" AutomationProperties.Name="立即刷新"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Style="{StaticResource MenuIcon}" Data="M16.5,6.5 C14,4 10,4 7.5,6.5 C4.8,9.2 4.8,13.8 7.5,16.5 C10.2,19.2 14.4,18.8 16.8,16 M16.5,3.5 L16.5,7.5 L12.5,7.5"/><TextBlock Margin="8,0,0,0" Grid.Column="1" Text="立即刷新" VerticalAlignment="Center"/></Grid></Button>
<Border x:Name="PrimaryFirstDivider" Height="0.5" Background="#18FFFFFF" Margin="10,5"/>
<Button x:Name="AppearanceButton" Style="{StaticResource MenuAction}" AutomationProperties.Name="外观与互动"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Style="{StaticResource MenuIcon}" Data="M3,4 L17,4 L17,17 L3,17 Z M3,8 L17,8 M8,8 L8,17"/><TextBlock Margin="8,0,0,0" Grid.Column="1" Text="外观与互动" VerticalAlignment="Center"/><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="StyleSummaryText" Visibility="Collapsed"/><Path x:Name="AppearanceChevron" RenderTransformOrigin="0.5,0.5" Width="5" Height="9" Stretch="Uniform" Stroke="#B5B5BA" StrokeThickness="1.3" Data="M0,0 L5,5 L0,10"><Path.RenderTransform><RotateTransform x:Name="AppearanceChevronRotation"/></Path.RenderTransform></Path></StackPanel></Grid></Button>
<Button x:Name="PreferencesButton" Style="{StaticResource MenuAction}" AutomationProperties.Name="功能设置"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Style="{StaticResource MenuIcon}" Data="M3,5 L17,5 M3,10 L17,10 M3,15 L17,15 M6,3 L6,7 M13,8 L13,12 M8,13 L8,17"/><TextBlock Margin="8,0,0,0" Grid.Column="1" Text="功能设置" VerticalAlignment="Center"/><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Path x:Name="PreferencesChevron" RenderTransformOrigin="0.5,0.5" Width="5" Height="9" Stretch="Uniform" Stroke="#B5B5BA" StrokeThickness="1.3" Data="M0,0 L5,5 L0,10"><Path.RenderTransform><RotateTransform x:Name="PreferencesChevronRotation"/></Path.RenderTransform></Path></StackPanel></Grid></Button>
<Border x:Name="PrimarySecondDivider" Height="0.5" Background="#18FFFFFF" Margin="10,5"/>
<Button x:Name="CheckUpdatesButton" Style="{StaticResource MenuAction}" AutomationProperties.Name="检查更新…"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Style="{StaticResource MenuIcon}" Data="M10,3.5 L10,13.5 M6.5,10 L10,13.5 L13.5,10 M4,17 L16,17"/><TextBlock Margin="8,0,0,0" Grid.Column="1" Text="检查更新…" VerticalAlignment="Center"/></Grid></Button>
<Button x:Name="ExitButton" Style="{StaticResource DangerAction}" AutomationProperties.Name="退出点岛"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path x:Name="ExitIcon" Style="{StaticResource MenuIcon}" Data="M9,4 L4,4 L4,16 L9,16 M12,7 L15,10 L12,13 M7,10 L15,10"/><TextBlock Margin="8,0,0,0" Grid.Column="1" Text="退出点岛" VerticalAlignment="Center"/></Grid></Button>
</StackPanel>

            <Border x:Name="AppearanceReveal" Visibility="Collapsed" IsHitTestVisible="False" Focusable="False">
              <Grid x:Name="AppearanceRoot" TextElement.FontFamily="{x:Static ui:OverlayTypography.Interface}" TextElement.FontSize="13" TextElement.Foreground="#F4FFFFFF" KeyboardNavigation.TabNavigation="Cycle">
                <Border x:Name="AppearanceGlass" Background="Transparent"><StackPanel x:Name="AppearanceItems">
                  <TextBlock Text="显示样式" Tag="secondary" Foreground="#A7ABB2" FontSize="12" Margin="8,3,8,6"/>
                  <Border Style="{StaticResource SegmentTrack}"><UniformGrid Columns="2">
<Button x:Name="ClassicStyleButton" Style="{StaticResource ChoiceAction}" Padding="6,0" AutomationProperties.Name="经典气泡"><Grid><TextBlock Text="经典气泡" VerticalAlignment="Center" HorizontalAlignment="Center"/><Path x:Name="ClassicStyleCheck" Width="12" Height="1" Data="M0,0 L12,0" Stroke="#99FFFFFF" StrokeThickness="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,1"/></Grid></Button><Button x:Name="UnifiedStyleButton" Style="{StaticResource ChoiceAction}" Padding="6,0" AutomationProperties.Name="一体面板"><Grid><TextBlock Text="一体面板" VerticalAlignment="Center" HorizontalAlignment="Center"/><Path x:Name="UnifiedStyleCheck" Width="12" Height="1" Data="M0,0 L12,0" Stroke="#99FFFFFF" StrokeThickness="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,1"/></Grid></Button>
                  </UniformGrid></Border>
                  <TextBlock Text="状态显示" Tag="secondary" Foreground="#A7ABB2" FontSize="12" Margin="8,7,8,6"/>
                  <Border Style="{StaticResource SegmentTrack}"><UniformGrid x:Name="CompanionShapeChoices" Columns="2"/></Border>
                  <StackPanel x:Name="BongoVisibilityItems"/>
                  <TextBlock Text="BongoCat 尺寸" Tag="secondary" Foreground="#A7ABB2" FontSize="12" Margin="8,7,8,6"/>
                  <Border Style="{StaticResource SegmentTrack}"><UniformGrid x:Name="CompanionSizeChoices" Columns="3"/></Border>
<Border Height="0.5" Background="#18FFFFFF" Margin="10,6"/>
                  <StackPanel Margin="6,4,6,2">
                    <Grid><TextBlock x:Name="MaterialTransparencyLabel" Text="材质透明度" FontSize="13"/><TextBlock x:Name="MaterialTransparencyValue" Text="0%" HorizontalAlignment="Right" FontSize="13"/></Grid>
                    <Slider x:Name="MaterialTransparencySlider" Style="{StaticResource MaterialSlider}" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" AutomationProperties.Name="材质透明度" AutomationProperties.HelpText="0% 不透明，100% 全透明；只影响背景，不改变文字和图标"/>
                    <TextBlock x:Name="MaterialTransparencyHint" Text="0% 不透明 · 100% 全透明" Foreground="#B8FFFFFF" FontSize="11" TextWrapping="Wrap"/>
                  </StackPanel>
<Border Height="0.5" Background="#18FFFFFF" Margin="10,6"/>
<Button x:Name="AllTaskbarsButton" Style="{StaticResource MenuAction}" AutomationProperties.Name="在全部任务栏显示"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="在全部任务栏显示" VerticalAlignment="Center"/><Border Grid.Column="1" Style="{StaticResource SwitchTrack}"><Grid><Border Style="{StaticResource SwitchOffThumb}"/><Path x:Name="AllTaskbarsCheck" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="2,0" Stretch="Fill" Data="M6,0 A6,6 0 1,1 5.999,0 Z" Fill="{DynamicResource MenuSwitchOnThumbBrush}" StrokeThickness="0"/></Grid></Border></Grid></Button>
                  <StackPanel x:Name="CompanionInteractionItems"/>
                </StackPanel></Border>
              </Grid>
            </Border>
            <Border x:Name="PreferencesReveal" Visibility="Collapsed" IsHitTestVisible="False" Focusable="False">
              <Grid x:Name="PreferencesRoot" TextElement.FontFamily="{x:Static ui:OverlayTypography.Interface}" TextElement.FontSize="13" TextElement.Foreground="#F4FFFFFF" KeyboardNavigation.TabNavigation="Cycle">
                <Border x:Name="PreferencesGlass" Background="Transparent"><StackPanel>
<Button x:Name="DotRealtimeButton" Style="{StaticResource MenuAction}" AutomationProperties.Name="Dot 实时接收" AutomationProperties.HelpText="关闭后释放 Dot 浏览器内存，停止接收新消息"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Dot 实时接收" VerticalAlignment="Center"/><Border Grid.Column="1" Style="{StaticResource SwitchTrack}"><Grid><Border Style="{StaticResource SwitchOffThumb}"/><Path x:Name="DotRealtimeCheck" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="2,0" Stretch="Fill" Data="M6,0 A6,6 0 1,1 5.999,0 Z" Fill="{DynamicResource MenuSwitchOnThumbBrush}" StrokeThickness="0"/></Grid></Border></Grid></Button>
<Button x:Name="SubscriptionLoginButton" Style="{StaticResource MenuAction}" AutomationProperties.Name="网页登录订阅…"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Style="{StaticResource MenuIcon}" Data="M4,5 L17,5 L17,17 L4,17 Z M4,9 L17,9 M7,7 L8,7"/><TextBlock Margin="8,0,0,0" Grid.Column="1" Text="网页登录订阅…" VerticalAlignment="Center"/></Grid></Button>
<Border x:Name="PreferencesFirstDivider" Height="0.5" Background="#18FFFFFF" Margin="10,5"/>
<Button x:Name="TrayIconButton" Style="{StaticResource MenuAction}" AutomationProperties.Name="显示托盘图标" AutomationProperties.HelpText="关闭后可右键点岛恢复；托盘气泡通知将暂停"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="显示托盘图标" VerticalAlignment="Center"/><Border Grid.Column="1" Style="{StaticResource SwitchTrack}"><Grid><Border Style="{StaticResource SwitchOffThumb}"/><Path x:Name="TrayIconCheck" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="2,0" Stretch="Fill" Data="M6,0 A6,6 0 1,1 5.999,0 Z" Fill="{DynamicResource MenuSwitchOnThumbBrush}" StrokeThickness="0"/></Grid></Border></Grid></Button>
